#!/usr/bin/env python3
"""Read Codex subscription limits and local token use."""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Any


SCRIPT_PATH = Path(__file__).resolve()
SCANNER_PATH = SCRIPT_PATH.parent / "ai-usage-scanners" / "codex_usage_scanner.py"
CACHE_PATH = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "ai-usage" / "usage.json"
CACHE_SECONDS = 300


def number(value: Any, fallback: float = 0.0) -> float:
  try:
    return float(value)
  except (TypeError, ValueError):
    return fallback


def integer(value: Any, fallback: int = 0) -> int:
  try:
    return round(float(value))
  except (TypeError, ValueError):
    return fallback


def normalized_percent(value: Any) -> float:
  percent = number(value, -1)
  if percent < 0:
    return -1
  if percent > 1:
    percent /= 100
  return max(0, min(1, percent))


def scan_codex() -> dict[str, Any]:
  env = {**os.environ, "PATH": os.pathsep.join([
    os.environ.get("PATH", ""),
    str(Path.home() / ".local" / "bin"),
  ])}
  try:
    result = subprocess.run(
      [sys.executable, str(SCANNER_PATH)], capture_output=True, text=True,
      timeout=45, check=False, env=env,
    )
  except (OSError, subprocess.TimeoutExpired):
    result = None
  try:
    raw = json.loads(result.stdout) if result else {}
  except json.JSONDecodeError:
    raw = {}

  status = str(raw.get("usageStatusText") or "")
  limits = []
  for label, percent_key, reset_key in (
    ("Session", "rateLimitPercent", "rateLimitResetAt"),
    ("Weekly", "secondaryRateLimitPercent", "secondaryRateLimitResetAt"),
  ):
    percent = normalized_percent(raw.get(percent_key))
    if percent >= 0:
      limits.append({"label": label, "percent": percent, "resetAt": str(raw.get(reset_key) or "")})
  if result is None or result.returncode != 0:
    status = status or "Codex usage unavailable"
  return {
    "id": "codex",
    "name": "Codex",
    "tier": str(raw.get("tierLabel") or ""),
    "status": status,
    "limits": limits,
    "todayTokens": max(0, integer(raw.get("todayTotalTokens"))),
    "todayPrompts": max(0, integer(raw.get("todayPrompts"))),
  }


def fetch_data(force: bool = False) -> dict[str, Any]:
  if not force:
    try:
      cached = json.loads(CACHE_PATH.read_text(encoding="utf-8"))
      age = dt.datetime.now().timestamp() - number(cached.get("updatedAt"), 0)
      if 0 <= age < CACHE_SECONDS and isinstance(cached.get("providers"), list):
        return cached
    except (OSError, json.JSONDecodeError):
      pass

  data = {"schemaVersion": 1, "updatedAt": dt.datetime.now().timestamp(), "providers": [scan_codex()]}
  CACHE_PATH.parent.mkdir(parents=True, exist_ok=True)
  with tempfile.NamedTemporaryFile("w", dir=CACHE_PATH.parent, delete=False, encoding="utf-8") as temporary:
    json.dump(data, temporary, separators=(",", ":"))
    temporary.write("\n")
    temporary_path = Path(temporary.name)
  temporary_path.replace(CACHE_PATH)
  return data


def reset_text(reset_at: str) -> str:
  if not reset_at:
    return ""
  try:
    raw = str(reset_at)
    if raw.isdigit():
      timestamp = float(raw)
      if timestamp > 10_000_000_000:
        timestamp /= 1000
      reset = dt.datetime.fromtimestamp(timestamp, tz=dt.timezone.utc)
    else:
      reset = dt.datetime.fromisoformat(raw.replace("Z", "+00:00"))
      if reset.tzinfo is None:
        reset = reset.replace(tzinfo=dt.datetime.now().astimezone().tzinfo)
    seconds = max(0, int((reset - dt.datetime.now(reset.tzinfo)).total_seconds()))
  except (TypeError, ValueError, OverflowError, OSError):
    return ""
  minutes = seconds // 60
  hours = minutes // 60
  days = hours // 24
  if days:
    return f"resets {days}d {hours % 24}h"
  if hours:
    return f"resets {hours}h {minutes % 60}m"
  return f"resets {max(1, minutes)}m"


def token_text(value: Any) -> str:
  tokens = max(0, number(value))
  if tokens >= 1_000_000_000:
    return f"{tokens / 1_000_000_000:.1f}B"
  if tokens >= 1_000_000:
    return f"{tokens / 1_000_000:.1f}M"
  if tokens >= 1_000:
    return f"{tokens / 1_000:.1f}K"
  return str(round(tokens))


def details_text(data: dict[str, Any]) -> str:
  provider = data["providers"][0]
  lines = [provider.get("name", "Codex")]
  if provider.get("tier"):
    lines[0] += f" · {provider['tier']}"
  for window in provider.get("limits", []):
    used = round(normalized_percent(window["percent"]) * 100)
    reset = reset_text(str(window.get("resetAt") or ""))
    suffix = f" · {reset}" if reset else ""
    lines.append(f"  {window['label']}: {used}% used · {100 - used}% left{suffix}")
  if provider.get("status"):
    lines.append(f"  {provider['status']}")
  elif not provider.get("limits"):
    lines.append("  No signed-in usage data")
  lines.append(
    f"  Today: {token_text(provider.get('todayTokens'))} tokens · "
    f"{max(0, integer(provider.get('todayPrompts')))} prompts",
  )
  updated = dt.datetime.fromtimestamp(number(data.get("updatedAt"), 0)).astimezone()
  lines.append(f"Updated {updated.strftime('%H:%M:%S')}")
  return "\n".join(lines)


def main() -> int:
  parser = argparse.ArgumentParser(description="Codex subscription usage")
  parser.add_argument("action", nargs="?", choices=("details", "refresh"), default="details")
  parser.add_argument("--json", action="store_true", help="emit status data as JSON")
  args = parser.parse_args()
  data = fetch_data(force=args.action == "refresh")
  if args.json:
    print(json.dumps(data["providers"][0]))
  else:
    print(details_text(data))
  return 0


if __name__ == "__main__":
  raise SystemExit(main())
