#!/bin/bash

set -euo pipefail

bin_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

usage() {
  cat <<'USAGE'
BLARCHY command center

Usage:
  blarchy update
  blarchy system update [yay options...]
  blarchy migrate [--pending]
  blarchy version
  blarchy debug [--no-sudo] [--print]
USAGE
}

case "${1:-}" in
  update)
    shift
    exec "$bin_dir/blarchy-update" "$@"
    ;;
  system)
    shift
    if [[ ${1:-} != "update" ]]; then
      usage >&2
      exit 2
    fi
    shift
    exec yay -Syu "$@"
    ;;
  migrate)
    shift
    exec "$bin_dir/blarchy-migrate" "$@"
    ;;
  version)
    shift
    exec "$bin_dir/blarchy-version" "$@"
    ;;
  debug)
    shift
    exec "$bin_dir/blarchy-debug" "$@"
    ;;
  -h|--help|"")
    usage
    ;;
  *)
    echo "Unknown BLARCHY command: $1" >&2
    usage >&2
    exit 2
    ;;
esac
