#!/bin/bash

set -euo pipefail

if (( $# != 2 )); then
  echo "Usage: blarchy-done <check|mark|ensure> <name>" >&2
  exit 1
fi

action=$1
name=$2
done_dir="${BLARCHY_DONE_STATE:-$HOME/.local/state/blarchy/done}"
legacy_dir="${OMARCHY_DONE_STATE:-$HOME/.local/state/omarchy/done}"
marker="$done_dir/$name"
legacy_marker="$legacy_dir/$name"

if [[ $name == */* || $name == "." || $name == ".." ]]; then
  echo "Invalid done marker name: $name" >&2
  exit 1
fi

completed() {
  [[ -f $marker || -f $legacy_marker ]]
}

case "$action" in
  check)
    completed
    ;;
  mark)
    mkdir -p "$done_dir"
    touch "$marker"
    ;;
  ensure)
    completed && exit 1
    mkdir -p "$done_dir"
    (set -o noclobber; : >"$marker") 2>/dev/null
    ;;
  *)
    echo "Usage: blarchy-done <check|mark|ensure> <name>" >&2
    exit 1
    ;;
esac
