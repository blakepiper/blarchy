#!/bin/bash

set -euo pipefail

mode="run"

usage() {
  echo "Usage: blarchy migrate [--pending]"
}

while (($#)); do
  case "$1" in
    --pending|--check)
      mode="pending"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
  esac
done

install_config="${BLARCHY_INSTALL_CONFIG:-/etc/blarchy.conf}"
BLARCHY_INSTALL_MODE="${BLARCHY_INSTALL_MODE:-}"
if [[ -r $install_config ]]; then
  source "$install_config"
fi

BLARCHY_PATH="${BLARCHY_PATH:-${OMARCHY_PATH:-/usr/local/share/blarchy}}"
BLARCHY_INSTALL="${BLARCHY_INSTALL:-$BLARCHY_PATH/install}"
STATE_DIR="${BLARCHY_MIGRATION_STATE:-$HOME/.local/state/blarchy/migrations}"
LEGACY_STATE_DIR="${OMARCHY_MIGRATION_STATE:-$HOME/.local/state/omarchy/migrations}"
MIGRATIONS_DIR="$BLARCHY_PATH/migrations"

# Historical migrations still use these compatibility variables internally.
export BLARCHY_PATH BLARCHY_INSTALL
export OMARCHY_PATH="$BLARCHY_PATH"
export OMARCHY_INSTALL="$BLARCHY_INSTALL"

import_legacy_markers() {
  local marker

  mkdir -p "$STATE_DIR"
  [[ -f $STATE_DIR/.legacy-imported ]] && return

  if [[ -d $LEGACY_STATE_DIR && $LEGACY_STATE_DIR != "$STATE_DIR" ]]; then
    for marker in "$LEGACY_STATE_DIR"/*.sh; do
      [[ -f $marker ]] || continue
      touch "$STATE_DIR/${marker##*/}"
    done
  fi
  touch "$STATE_DIR/.legacy-imported"
}

migration_supported() {
  local file="$1"

  if [[ $BLARCHY_INSTALL_MODE == "standalone" ]] &&
    grep -qx '# blarchy:standalone-safe=false' "$file"; then
    return 1
  fi
}

migration_entries() {
  [[ -d $MIGRATIONS_DIR ]] || return 0

  local file filename
  while IFS= read -r -d '' file; do
    migration_supported "$file" || continue
    filename=${file##*/}
    printf '%s\t%s\t%s\n' "$filename" "$file" "$STATE_DIR/$filename"
  done < <(find "$MIGRATIONS_DIR" -maxdepth 1 -type f -name '*.sh' -print0 | sort -z)
}

pending_migrations() {
  local name file marker

  while IFS=$'\t' read -r name file marker; do
    [[ -n $name ]] || continue
    [[ -f $marker ]] || printf '%s\n' "$name"
  done < <(migration_entries)
}

import_legacy_markers

if [[ $mode == "pending" ]]; then
  pending_output=$(pending_migrations)
  if [[ -n $pending_output ]]; then
    printf '%s\n' "$pending_output"
    exit 0
  fi
  exit 1
fi

wait_for_pacman_transaction() {
  local lock_file=/var/lib/pacman/db.lck

  [[ -e $lock_file ]] || return 0
  echo "Waiting for pacman transaction to finish before running BLARCHY migrations..."
  for _ in {1..900}; do
    [[ -e $lock_file ]] || return 0
    sleep 1
  done
  echo "Pacman transaction is still running; BLARCHY migrations will retry on next login."
  exit 0
}

wait_for_pacman_transaction
[[ -d $MIGRATIONS_DIR ]] || exit 0

while IFS=$'\t' read -r name file marker; do
  [[ -n $name ]] || continue
  if [[ ! -f $marker ]]; then
    echo -e "\e[32m\nRunning migration (${name%.sh})\e[0m"
    bash -euo pipefail "$file"
    touch "$marker"
  fi
done < <(migration_entries)

omarchy-notification-dismiss "BLARCHY Migrations" >/dev/null 2>&1 || true
