#!/bin/bash

set -euo pipefail

update_in_progress() {
  local lock="${XDG_RUNTIME_DIR:-}/blarchy-update.lock"

  [[ -n ${XDG_RUNTIME_DIR:-} && -f $lock ]] || return 1
  ! flock -n "$lock" true 2>/dev/null
}

update_in_progress && exit 0

pending_migrations=$(blarchy-migrate --pending 2>/dev/null) || exit 0
pending_count=$(printf '%s\n' "$pending_migrations" | sed '/^[[:space:]]*$/d' | wc -l)

if (( pending_count == 1 )); then
  message="Click to run 1 pending migration."
else
  message="Click to run $pending_count pending migrations."
fi

notify_command=$(printf 'if [[ -n $(omarchy-notification-send -u critical -g  "Pending BLARCHY Migrations" %q -a) ]]; then omarchy-launch-floating-terminal-with-presentation blarchy migrate; fi' "$message")

omarchy-notification-wait || true
update_in_progress && exit 0

unit="blarchy-migrations-notification-$(date +%Y%m%d%H%M%S)"
systemd-run --user --collect --slice=background-graphical.slice --unit="$unit" bash -lc "$notify_command" >/dev/null 2>&1 && exit 0

echo "BLARCHY has pending migrations. Run 'blarchy migrate' in a terminal to apply them:" >&2
while IFS= read -r migration; do
  [[ -n $migration ]] && printf '  %s\n' "$migration" >&2
done <<<"$pending_migrations"
