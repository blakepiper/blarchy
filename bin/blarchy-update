#!/bin/bash

set -euo pipefail

if (( $# > 0 )); then
  echo "Usage: blarchy update" >&2
  exit 2
fi

install_config="${BLARCHY_INSTALL_CONFIG:-/etc/blarchy.conf}"
if [[ -r $install_config ]]; then
  source "$install_config"
fi

source_path=${BLARCHY_SOURCE_PATH:-}

# Legacy development installs may run this command directly from a source
# checkout before /etc/blarchy.conf has been refreshed. Recover that checkout
# from the resolved command path, but only when it is actually a Git worktree.
if [[ -z $source_path ]]; then
  updater_path=$(realpath -- "${BASH_SOURCE[0]}" 2>/dev/null || true)
  if [[ -n $updater_path ]]; then
    checkout_candidate=$(cd -- "$(dirname -- "$updater_path")/.." && pwd -P)
    if git -C "$checkout_candidate" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      source_path=$checkout_candidate
    fi
  fi
fi

source_path=${source_path%/}

lock_dir=${XDG_RUNTIME_DIR:-$HOME/.local/state/blarchy}
mkdir -p "$lock_dir"
exec {update_lock_fd}>"$lock_dir/blarchy-update.lock"
if ! flock -n "$update_lock_fd"; then
  echo "A BLARCHY update is already running." >&2
  exit 1
fi

echo "Update Arch and AUR packages"
yay -Syu

if [[ -z $source_path ]]; then
  echo "BLARCHY_SOURCE_PATH is not configured and no source checkout was found." >&2
  echo "Arch and AUR packages were updated, but BLARCHY could not be updated." >&2
  echo "Run the BLARCHY installer from a Git checkout, then retry." >&2
  exit 1
fi

if ! git -C "$source_path" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "BLARCHY_SOURCE_PATH is not a Git checkout: $source_path" >&2
  echo "Arch and AUR packages were updated, but BLARCHY could not be updated." >&2
  exit 1
fi

if [[ -n $(git -C "$source_path" status --porcelain) ]]; then
  echo "Refusing to update a BLARCHY source checkout with local changes: $source_path" >&2
  echo "Arch and AUR packages were updated, but BLARCHY could not be updated." >&2
  echo "Commit, stash, or discard those changes, then retry." >&2
  exit 1
fi

upstream=$(git -C "$source_path" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)
if [[ -z $upstream ]]; then
  echo "The current BLARCHY branch has no tracked upstream." >&2
  echo "Arch and AUR packages were updated, but BLARCHY could not be updated." >&2
  exit 1
fi

remote=${upstream%%/*}
branch=${upstream#*/}
remote_url=$(git -C "$source_path" remote get-url "$remote" 2>/dev/null || true)
case "$remote_url" in
  https://github.com/blakepiper/blarchy|https://github.com/blakepiper/blarchy.git|git@github.com:blakepiper/blarchy|git@github.com:blakepiper/blarchy.git|ssh://git@github.com/blakepiper/blarchy|ssh://git@github.com/blakepiper/blarchy.git)
    ;;
  *)
    echo "Refusing to update BLARCHY from an untrusted remote: ${remote_url:-<missing>}" >&2
    echo "Arch and AUR packages were updated, but BLARCHY could not be updated." >&2
    echo "The update remote must be github.com/blakepiper/blarchy." >&2
    exit 1
    ;;
esac

echo "Update BLARCHY from $upstream"
git -C "$source_path" pull --ff-only "$remote" "$branch"

echo "Install the updated BLARCHY runtime"
exec bash "$source_path/install.sh"
