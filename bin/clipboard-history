#!/bin/bash

# Select text or an image from history, then paste normally in the target app.
set -euo pipefail

selection=$(cliphist list | fuzzel --dmenu --prompt 'Clipboard: ') || exit 0
[[ -n $selection ]] || exit 0

# Decode before taking ownership of the clipboard. A cancellation or missing
# history entry must not clear it, and binary image data must stay intact.
decoded=$(mktemp)
trap 'rm -f -- "$decoded"' EXIT
printf '%s\n' "$selection" | cliphist decode >"$decoded"
wl-copy <"$decoded"
