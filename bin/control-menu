#!/bin/bash
# Session controls for the Hyprland keyboard shortcut.

set -euo pipefail

confirm() {
  local answer
  answer=$(printf 'No\nYes\n' | wofi --dmenu --hide-search --no-custom-entry --prompt "$1") || return 1
  [[ $answer == Yes ]]
}

selection=$(printf '%s\n' \
  '  Lock' \
  '  Suspend' \
  '  Reboot' \
  '󰗽  Log Out' \
  '󰍹  Monitors Off' \
  '  Power Off' \
  | wofi --dmenu --hide-search --no-custom-entry --prompt 'Control') || exit 0

[[ -n $selection ]] || exit 0

case $selection in
  *Lock*) exec hyprlock ;;
  *Suspend*)
    hyprlock &
    sleep 0.5
    exec systemctl suspend
    ;;
  *Reboot*)
    confirm 'Reboot?' || exit 0
    exec systemctl reboot
    ;;
  *Power*)
    confirm 'Power off?' || exit 0
    exec systemctl poweroff
    ;;
  *Log*)
    confirm 'Log out? Unsaved work may be lost.' || exit 0
    exec hyprctl dispatch exit
    ;;
  *Monitors*) exec hyprctl dispatch dpms off ;;
  *) exit 0 ;;
esac
