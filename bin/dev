#!/bin/bash

# dev: open the current project in a three-pane tmux session - nvim on the
# left, a blank shell in the upper-right, and hyfetch in the lower-right.
#
# Usage: dev (run from inside the project directory)

set -euo pipefail

if ! command -v tmux >/dev/null 2>&1; then
  echo "dev: tmux not found on PATH." >&2
  exit 1
fi
if ! command -v nvim >/dev/null 2>&1; then
  echo "dev: nvim not found on PATH." >&2
  exit 1
fi
if ! command -v hyfetch >/dev/null 2>&1; then
  echo "dev: hyfetch not found on PATH." >&2
  exit 1
fi

project_dir=$(pwd -P)
project_name=$(basename "$project_dir")
project_hash=$(printf '%s' "$project_dir" | sha256sum | cut -c1-8)
session_name="dev-${project_name//[^[:alnum:]_.-]/-}-$project_hash"

attach() {
  if [[ -n ${TMUX-} ]]; then
    exec tmux switch-client -t "$session_name"
  fi
  exec tmux attach-session -t "$session_name"
}

# Reuse the project's session when dev is run again.
if tmux has-session -t "$session_name" 2>/dev/null; then
  attach
fi

# Start nvim in the left pane, then split the right side vertically.
tmux new-session -d -s "$session_name" -c "$project_dir" "nvim ."
tmux split-window -h -t "$session_name:0.0" -c "$project_dir"

user_shell=${SHELL:-/bin/bash}
quoted_shell=$(printf '%q' "$user_shell")
tmux split-window -v -t "$session_name:0.1" -c "$project_dir" \
  "$quoted_shell -i -c 'hyfetch; exec $quoted_shell -i'"

tmux select-pane -t "$session_name:0.0"
attach
