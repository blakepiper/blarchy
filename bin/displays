#!/bin/bash
# List active Hyprland monitors or DRM connectors from a TTY.

set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: displays [--drm|--help]

Show active monitor modes in Hyprland, or the connected DRM outputs from a TTY.
USAGE
}

drm_report() {
  local status_file dir node connector status preferred kind found=0
  for status_file in /sys/class/drm/card*-*/status; do
    [[ -e $status_file ]] || continue
    found=1
    dir=${status_file%/status}
    node=${dir##*/}
    connector=${node#*-}
    status=$(<"$status_file")
    if [[ $status == connected ]]; then
      preferred=$(head -n 1 "${status_file%/status}/modes" 2>/dev/null || true)
      [[ -n $preferred ]] || preferred='unknown mode'
    else
      preferred=--
    fi
    case $connector in
      eDP-*|LVDS-*|DSI-*) kind=internal ;;
      *) kind=external ;;
    esac
    printf '%s: %s (%s) [%s]\n' "$connector" "$status" "$preferred" "$kind"
  done
  (( found )) || { echo 'Error: no DRM connectors found.' >&2; return 1; }
}

if (( $# > 0 )); then
  case $1 in
    --help|-h) usage ;;
    --drm) drm_report ;;
    *) usage >&2; exit 1 ;;
  esac
  exit 0
fi

if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] && command -v hyprctl >/dev/null 2>&1; then
  monitor_data=$(hyprctl monitors -j)
  python3 - "$monitor_data" <<'PY'
import json
import sys

for monitor in json.loads(sys.argv[1]):
  rate = monitor.get("refreshRate", 0)
  print(f"{monitor.get('name', '?')}: {monitor.get('width', '?')}x{monitor.get('height', '?')}@{rate:.3f} scale={monitor.get('scale', '?')}")
PY
else
  drm_report
fi
