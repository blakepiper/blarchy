#!/usr/bin/env python3
"""Seed Firefox's profile-local user.js and chrome stylesheets."""

from configparser import RawConfigParser
from pathlib import Path
import shutil
import subprocess
import sys


HOME = Path.home()
PROFILE_ROOT = HOME / ".mozilla/firefox"
CONFIG_ROOT = HOME / ".config/firefox"
PROFILE_NAME = "desktop-default"


def profile_directories():
  profiles_ini = PROFILE_ROOT / "profiles.ini"
  if profiles_ini.exists():
    parser = RawConfigParser()
    parser.read(profiles_ini, encoding="utf-8")
    directories = []
    for section in parser.sections():
      if not section.startswith("Profile") and not section.startswith("Install"):
        continue
      relative_path = parser.get(section, "Path", fallback="")
      if section.startswith("Install"):
        relative_path = parser.get(section, "Default", fallback=relative_path)
      if not relative_path:
        continue
      path = Path(relative_path).expanduser()
      if parser.get(section, "IsRelative", fallback="1") == "1" and not path.is_absolute():
        path = PROFILE_ROOT / path
      if path.is_dir() and path not in directories:
        directories.append(path)
    if directories:
      return directories

  PROFILE_ROOT.mkdir(parents=True, exist_ok=True)
  profile_path = PROFILE_ROOT / "Profiles" / PROFILE_NAME
  profile_path.parent.mkdir(parents=True, exist_ok=True)
  if profile_path.exists():
    raise RuntimeError(f"Firefox profile path already exists but is not registered: {profile_path}")
  subprocess.run(
    ["firefox", "-no-remote", "-CreateProfile", f"{PROFILE_NAME} {profile_path}"],
    check=True,
  )
  if profile_path.is_dir():
    return [profile_path]
  raise RuntimeError("Firefox created no profile directory")


def seed_file(source, destination):
  if destination.exists() or destination.is_symlink():
    return False
  destination.parent.mkdir(parents=True, exist_ok=True)
  shutil.copy2(source, destination)
  return True


def main():
  sources = (
    (CONFIG_ROOT / "user.js", "user.js"),
    (CONFIG_ROOT / "chrome/userChrome.css", "chrome/userChrome.css"),
    (CONFIG_ROOT / "chrome/userContent.css", "chrome/userContent.css"),
  )
  missing = [source for source, _ in sources if not source.is_file()]
  if missing:
    raise RuntimeError("Firefox profile defaults are missing from ~/.config/firefox")

  copied = 0
  for directory in profile_directories():
    for source, relative in sources:
      copied += seed_file(source, directory / relative)
  print(f"Seeded Firefox profile defaults ({copied} file(s)).")
  return 0


if __name__ == "__main__":
  try:
    raise SystemExit(main())
  except (OSError, RuntimeError, subprocess.CalledProcessError) as error:
    print(f"Firefox profile setup failed: {error}", file=sys.stderr)
    raise SystemExit(1)
