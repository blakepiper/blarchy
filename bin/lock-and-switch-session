#!/bin/bash

set -euo pipefail

current_desktop=${XDG_CURRENT_DESKTOP:-}

if [[ ${current_desktop,,} == *xfce* ]]; then
  xflock4
else
  omarchy system lock
fi

# Leave the current desktop locked, then show SDDM so another session can be
# selected without logging out of this one.
busctl call \
  --system \
  org.freedesktop.DisplayManager \
  /org/freedesktop/DisplayManager/Seat0 \
  org.freedesktop.DisplayManager.Seat \
  SwitchToGreeter
