#!/bin/bash

# omarchy:summary=Explain why Omarchy package channels are disabled in BLARCHY.
# omarchy:args=<stable|rc|edge|dev>

set -euo pipefail

echo "BLARCHY does not use Omarchy package channels." >&2
echo "Update Arch packages with omarchy-update and configure the current Git branch to track the BLARCHY fork." >&2
exit 1
