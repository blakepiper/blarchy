#!/bin/bash

# omarchy:summary=Print desktop debugging information
# omarchy:args=[--no-sudo] [--print]

set -euo pipefail

no_sudo=0
print_only=0
while (($#)); do
  case "$1" in
    --no-sudo)
      no_sudo=1
      shift
      ;;
    --print)
      print_only=1
      shift
      ;;
    -h|--help)
      echo "Usage: omarchy debug [--no-sudo] [--print]"
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
  esac
done

log_file="${RICE_DEBUG_LOG:-/tmp/arch-rice-debug.log}"
if (( no_sudo )); then
  dmesg_output="(skipped - --no-sudo flag used)"
else
  dmesg_output=$(sudo dmesg)
fi

cat >"$log_file" <<EOF
Date: $(date)
Hostname: $(hostname)
Desktop runtime: ${RICE_PATH:-/usr/local/share/rice}

=========================================
SYSTEM INFORMATION
=========================================
$(inxi -Farz)

=========================================
DMESG
=========================================
$dmesg_output

=========================================
JOURNALCTL (CURRENT BOOT, WARNINGS+ERRORS)
=========================================
$(journalctl -b -p 4..1)

=========================================
INSTALLED PACKAGES
=========================================
$({ expac -S '%n %v (%r)' $(pacman -Qqe) 2>/dev/null; comm -13 <(pacman -Sql | sort) <(pacman -Qqe | sort) | xargs -r expac -Q '%n %v (AUR)'; } | sort)
EOF

if (( print_only )); then
  cat "$log_file"
  exit 0
fi

case $(gum choose "View log" "Save in current directory") in
  "View log")
    less "$log_file"
    ;;
  "Save in current directory")
    cp "$log_file" ./arch-rice-debug.log
    echo "Log saved to $(pwd)/arch-rice-debug.log"
    ;;
esac
