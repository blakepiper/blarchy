#!/bin/bash

# omarchy:summary=Create a new BLARCHY migration in the current source tree.
# omarchy:args=[--no-edit]

set -euo pipefail

no_edit=0

while (($#)); do
  case "$1" in
    --no-edit)
      no_edit=1
      shift
      ;;
    system|user)
      echo "omarchy-dev-add-migration: migration scopes are no longer used; creating a regular migration." >&2
      shift
      ;;
    -h|--help)
      echo "Usage: omarchy-dev-add-migration [--no-edit]"
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      echo "Usage: omarchy-dev-add-migration [--no-edit]" >&2
      exit 1
      ;;
  esac
done

source_path=""
if git -C "$PWD" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  source_path=$(git -C "$PWD" rev-parse --show-toplevel)
elif [[ -n ${BLARCHY_SOURCE_PATH:-} ]] &&
  git -C "$BLARCHY_SOURCE_PATH" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  source_path=$(git -C "$BLARCHY_SOURCE_PATH" rev-parse --show-toplevel)
else
  command_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
  if git -C "$command_root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    source_path=$(git -C "$command_root" rev-parse --show-toplevel)
  fi
fi

if [[ -z $source_path ]]; then
  echo "Error: could not find the BLARCHY source checkout." >&2
  exit 1
fi

cd "$source_path"
mkdir -p migrations
migration_file="migrations/$(git log -1 --format=%cd --date=unix).sh"
touch "$migration_file"

if (( ! no_edit )); then
  "${EDITOR:-codium}" "$migration_file"
fi

printf '%s\n' "$PWD/$migration_file"
