#!/bin/bash

# omarchy:summary=Temporarily point RICE runtime code at another checkout after reboot
# omarchy:group=dev
# omarchy:args=<path-to-checkout> [--no-reboot]
# omarchy:examples=omarchy dev link ~/src/rice

set -euo pipefail

if (( EUID == 0 )); then
  echo "Error: run omarchy-dev-link as your user, not under sudo." >&2
  exit 1
fi

prompt_reboot=1

if (( $# < 1 || $# > 2 )) || [[ $1 == "-h" || $1 == "--help" ]]; then
  cat <<USAGE
Usage: omarchy dev link <path-to-checkout> [--no-reboot]

Writes /etc/rice-dev.conf so RICE_PATH resolves to <path-to-checkout>
after reboot. OMARCHY_PATH follows it as a compatibility alias. This
intentionally does not rewrite the running Hyprland,
systemd, shell, or app-launcher environment; reboot to make every layer agree.

Affects only runtime-resolved trees: bin/, default/, shell/, themes/,
applications/, and config/. It does not reinstall fixed system integration
under /etc or /usr/lib. To validate those paths, run that checkout's
idempotent ./install.sh in a disposable Arch VM.

Use --no-reboot when another command will handle the reboot prompt.
USAGE
  exit 0
fi

if (( $# == 2 )); then
  if [[ $2 == "--no-reboot" ]]; then
    prompt_reboot=0
  else
    echo "Usage: omarchy dev link <path-to-checkout> [--no-reboot]" >&2
    exit 1
  fi
fi

rice_conf_quote() {
  local value="$1"
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//\$/\\\$}
  value=${value//\`/\\\`}
  printf '"%s"' "$value"
}

target=$(realpath -e "$1" 2>/dev/null) || {
  echo "Error: path does not exist: $1" >&2
  exit 1
}

for required in bin default shell; do
  if [[ ! -d $target/$required ]]; then
    echo "Warning: $target/$required not found — does this look like a RICE source checkout?" >&2
  fi
done

{
  printf 'export RICE_PATH='
  rice_conf_quote "$target"
  printf '\nexport OMARCHY_PATH="$RICE_PATH"\n'
} | sudo tee /etc/rice-dev.conf >/dev/null

echo "Pointed RICE at $target"
echo

if (( prompt_reboot )) && gum confirm "Reboot now to activate?"; then
  omarchy-system-reboot
fi
