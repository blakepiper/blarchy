#!/bin/bash

# omarchy:summary=Show the current RICE dev-link state
# omarchy:group=dev

set -euo pipefail

default_target="/usr/local/share/rice"
configured="$default_target"
conf_present=0
linked=0

if [[ -f /etc/rice-dev.conf ]]; then
  conf_present=1
  configured=$(
    RICE_PATH=
    # shellcheck disable=SC1091
    . /etc/rice-dev.conf
    printf '%s' "${RICE_PATH:-<empty>}"
  )
  if [[ $configured != "$default_target" ]]; then
    linked=1
  fi
fi

if (( linked )); then
  echo "dev-link: configured"
  echo "  /etc/rice-dev.conf -> RICE_PATH=$configured"
  echo "  status: reboot required before all session layers use this checkout"
else
  echo "dev-link: inactive"
  if (( conf_present )); then
    echo "  /etc/rice-dev.conf -> RICE_PATH=$configured (default guard)"
  fi
fi

echo "  current shell:       RICE_PATH=${RICE_PATH:-<unset>}"

if [[ ${RICE_PATH:-$default_target} != "$configured" ]]; then
  echo
  echo "Note: the running session does not match /etc/rice-dev.conf. Reboot to settle it."
fi
