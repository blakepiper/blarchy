#!/bin/bash

# omarchy:summary=Launch the default editor selected by BLARCHY.
# omarchy:args=[--inline] <path>

omarchy-hyprland-window-prepare-launch
default_editor="$HOME/.local/state/omarchy/defaults/editor"

if [[ ${1:-} == "--inline" ]]; then
  inline=true
  shift
else
  inline=false
fi

if [[ -f $default_editor ]]; then
  read -r editor <"$default_editor"
else
  editor="codium"
fi

omarchy-cmd-present "$editor" || editor="codium"

case "${editor##*/}" in
vim | nano | micro | hx | helix | fresh)
  if [[ $inline == "true" ]]; then
    exec "$editor" "$@"
  else
    exec omarchy-launch-tui "$editor" "$@"
  fi
  ;;
*)
  exec setsid uwsm-app -- "$editor" "$@"
  ;;
esac
