#!/bin/bash

# omarchy:summary=Launch a Steam game and close its originating terminal
# omarchy:args=<steam-app-id>
# omarchy:examples=omarchy launch steam-game 123456

set -euo pipefail

if (($# != 1)) || [[ ! $1 =~ ^[0-9]+$ ]]; then
  echo "Usage: omarchy launch steam-game <steam-app-id>" >&2
  exit 2
fi

if omarchy-cmd-missing steam; then
  echo "omarchy launch steam-game: Steam was not found on PATH." >&2
  exit 127
fi
steam_bin=steam

terminal_address=""
if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
  active_window=$(hyprctl activewindow -j 2>/dev/null || true)
  active_pid=$(jq -r '.pid // empty' <<<"$active_window")
  active_address=$(jq -r '.address // empty' <<<"$active_window")

  # Only close an active window that owns this shell's process tree. This
  # avoids closing an unrelated window when the helper is launched indirectly.
  ancestor_pid=$$
  while [[ $ancestor_pid =~ ^[0-9]+$ ]] && (( ancestor_pid > 1 )); do
    if [[ $ancestor_pid == "$active_pid" && -n $active_address ]]; then
      terminal_address=$active_address
      break
    fi

    parent_pid=$(ps -o ppid= -p "$ancestor_pid" | tr -d ' ')
    [[ $parent_pid =~ ^[0-9]+$ ]] || break
    [[ $parent_pid != "$ancestor_pid" ]] || break
    ancestor_pid=$parent_pid
  done
fi

# Steam receives the AppID, not a library path or executable name. Detach it
# before closing the terminal so the game survives the terminal's SIGHUP.
nohup setsid -f "$steam_bin" -applaunch "$1" \
  >/dev/null 2>&1 </dev/null &

if [[ -n $terminal_address ]]; then
  sleep 0.25
  hyprctl dispatch \
    "hl.dsp.window.close({ window = \"address:$terminal_address\" })" \
    >/dev/null 2>&1 || true
fi
