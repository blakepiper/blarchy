#!/bin/bash

# omarchy:summary=Install a small mise-backed wrapper for a given tool.
# omarchy:args=<package> [command-name [bin-name]]

if [[ -z $1 ]]; then
  echo "Usage: omarchy-mise-install <package> [command-name [bin-name]]"
  exit 1
fi

package=$1
command=${2:-$1}
bin=${3:-$command}

mkdir -p "$HOME/.local/bin"

target="$HOME/.local/bin/$command"
if [[ ${OMARCHY_PRESERVE_USER_CONFIG:-0} == "1" && ( -e $target || -L $target ) ]]; then
  echo "Preserve existing command: $target"
  exit 0
fi

cat >"$target" <<EOF
#!/bin/bash
mise use -g "$package" || exit 1
exec mise x "$package" -- "$bin" "\$@"
EOF

chmod +x "$target"
