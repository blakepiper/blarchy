#!/usr/bin/env python3

# omarchy:summary=Render AI usage for the XFCE panel
# omarchy:group=bar
# omarchy:hidden=true

"""Render the model-usage widget for the XFCE Generic Monitor plugin."""

from __future__ import annotations

import argparse
import concurrent.futures
import datetime as dt
import html
import json
import os
import shlex
import subprocess
import sys
import tempfile
import urllib.error
import urllib.request
from pathlib import Path
from typing import Any


SCRIPT_PATH = Path(__file__).resolve()
SOURCE_ROOT = SCRIPT_PATH.parent.parent
CONFIG_PATH = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "omarchy" / "shell.json"
CACHE_PATH = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "omarchy" / "model-usage" / "xfce.json"
CACHE_SECONDS = 300


def runtime_root() -> Path:
  configured = os.environ.get("RICE_PATH") or os.environ.get("OMARCHY_PATH")
  if configured:
    candidate = Path(configured).expanduser()
    if (candidate / "shell" / "plugins" / "model-usage" / "scripts").is_dir():
      return candidate
  return SOURCE_ROOT


def expand_path(value: str) -> Path:
  return Path(os.path.expandvars(os.path.expanduser(value))).resolve()


def number(value: Any, fallback: float = 0.0) -> float:
  try:
    return float(value)
  except (TypeError, ValueError):
    return fallback


def integer(value: Any, fallback: int = 0) -> int:
  try:
    return round(float(value))
  except (TypeError, ValueError):
    return fallback


def normalized_percent(value: Any) -> float:
  percent = number(value, -1)
  if percent < 0:
    return -1
  if percent > 1:
    percent /= 100
  return max(0, min(1, percent))


def run_json(command: list[str], timeout: int = 20) -> dict[str, Any] | None:
  try:
    result = subprocess.run(
      command,
      capture_output=True,
      text=True,
      timeout=timeout,
      check=False,
      env={**os.environ, "PATH": os.pathsep.join([
        os.environ.get("PATH", ""),
        str(Path.home() / ".local" / "bin"),
        str(Path.home() / ".local" / "share" / "mise" / "shims"),
      ])},
    )
  except (OSError, subprocess.TimeoutExpired):
    return None

  for line in reversed(result.stdout.splitlines()):
    try:
      data = json.loads(line)
    except json.JSONDecodeError:
      continue
    if isinstance(data, dict):
      return data
  return None


def base_provider(provider_id: str, name: str) -> dict[str, Any]:
  return {
    "id": provider_id,
    "name": name,
    "tier": "",
    "status": "",
    "limits": [],
    "todayTokens": 0,
    "todayPrompts": 0,
  }


def limit(label: str, percent: Any, reset_at: Any = "") -> dict[str, Any]:
  return {
    "label": str(label or "Limit"),
    "percent": normalized_percent(percent),
    "resetAt": str(reset_at or ""),
  }


def pretty_tier(rate_limit_tier: Any, subscription_type: Any) -> str:
  tier = str(rate_limit_tier or "").strip()
  subscription = str(subscription_type or "").strip()
  if tier.lower().startswith("max_"):
    return "Max " + tier[4:]
  value = tier or subscription
  if not value:
    return ""
  return value.replace("_", " ").title().replace(" Ai", " AI")


def apply_local_stats(provider: dict[str, Any], data: dict[str, Any]) -> None:
  provider["todayTokens"] = max(0, integer(data.get("todayTotalTokens")))
  provider["todayPrompts"] = max(0, integer(data.get("todayPrompts")))


def claude_stats_fallback(provider: dict[str, Any], stats_path: Path) -> None:
  try:
    data = json.loads(stats_path.read_text(encoding="utf-8"))
  except (OSError, json.JSONDecodeError):
    return

  today = dt.datetime.now().strftime("%Y-%m-%d")
  today_entry = next(
    (entry for entry in data.get("dailyModelTokens", []) if entry.get("date") == today),
    {},
  )
  tokens = today_entry.get("tokensByModel", {})
  provider["todayTokens"] = max(0, sum(integer(value) for value in tokens.values()))
  activity = data.get("dailyActivity", [])
  latest_activity = activity[-1] if isinstance(activity, list) and activity else {}
  provider["todayPrompts"] = max(0, integer(latest_activity.get("messageCount", 0)))


def read_shell_settings() -> dict[str, Any]:
  try:
    data = json.loads(CONFIG_PATH.read_text(encoding="utf-8"))
  except (OSError, json.JSONDecodeError):
    return {}

  entries: list[Any] = []
  bar = data.get("bar") if isinstance(data, dict) else None
  layout = bar.get("layout") if isinstance(bar, dict) else None
  if isinstance(layout, dict):
    for section in ("left", "center", "right"):
      entries.extend(layout.get(section, []))

  for entry in entries:
    if isinstance(entry, dict) and entry.get("id") in ("omarchy.model-usage", "model-usage"):
      return entry
  return {}


def provider_settings(name: str, settings: dict[str, Any]) -> dict[str, Any]:
  providers = settings.get("providers") if isinstance(settings, dict) else None
  configured = providers.get(name) if isinstance(providers, dict) else None
  return configured if isinstance(configured, dict) else {}


def claude_provider(settings: dict[str, Any]) -> dict[str, Any]:
  provider = base_provider("claude", "Claude Code")
  projects_path = expand_path(settings.get("projectsPath", "~/.claude/projects"))
  scanner = runtime_root() / "shell" / "plugins" / "model-usage" / "scripts" / "claude_usage_scanner.py"
  data = run_json([sys.executable, str(scanner), str(projects_path)], timeout=45)
  if data:
    apply_local_stats(provider, data)

  stats_path = expand_path(settings.get("statsPath", "~/.claude/stats-cache.json"))
  if provider["todayTokens"] == 0:
    claude_stats_fallback(provider, stats_path)

  credentials_path = expand_path(settings.get("credentialsPath", "~/.claude/.credentials.json"))
  try:
    credentials = json.loads(credentials_path.read_text(encoding="utf-8"))
    oauth = credentials.get("claudeAiOauth", {})
  except (OSError, json.JSONDecodeError):
    oauth = {}

  provider["tier"] = pretty_tier(oauth.get("rateLimitTier"), oauth.get("subscriptionType"))
  token = str(oauth.get("accessToken") or "")
  expires_at = number(oauth.get("expiresAt"), 0)
  if expires_at and expires_at < 10_000_000_000:
    expires_at *= 1000

  if not token:
    provider["status"] = "Waiting for auth"
    return provider
  if expires_at and expires_at <= dt.datetime.now().timestamp() * 1000:
    provider["status"] = "Claude auth expired"
    return provider

  request = urllib.request.Request(
    "https://api.anthropic.com/api/oauth/usage",
    headers={
      "Authorization": f"Bearer {token}",
      "anthropic-beta": "oauth-2025-04-20",
      "Accept": "application/json",
    },
  )
  try:
    with urllib.request.urlopen(request, timeout=8) as response:
      payload = json.load(response)
  except (OSError, ValueError, urllib.error.URLError):
    provider["status"] = "Claude limits unavailable"
    return provider

  weekly = payload.get("seven_day_oauth_apps") or payload.get("seven_day") or {}
  session = payload.get("five_hour") or {}
  values = [number(weekly.get("utilization"), -1), number(session.get("utilization"), -1)]
  percent_scale = any(value >= 1 for value in values)

  def claude_percent(value: Any) -> float:
    parsed = number(value, -1)
    if parsed < 0:
      return -1
    if percent_scale or parsed > 1:
      parsed /= 100
    return max(0, min(1, parsed))

  provider["limits"] = [
    {
      "label": "Session (5-hour)",
      "percent": claude_percent(session.get("utilization")),
      "resetAt": str(session.get("resets_at") or ""),
    },
    {
      "label": "Weekly (7-day)",
      "percent": claude_percent(weekly.get("utilization")),
      "resetAt": str(weekly.get("resets_at") or ""),
    },
  ]
  return provider


def scanner_provider(
  provider_id: str,
  name: str,
  command: list[str],
  limit_keys: list[tuple[str, str, str]],
) -> dict[str, Any]:
  provider = base_provider(provider_id, name)
  data = run_json(command, timeout=45)
  if not data:
    provider["status"] = f"{name} unavailable"
    return provider

  apply_local_stats(provider, data)
  provider["tier"] = str(data.get("tierLabel") or "")
  provider["status"] = str(data.get("usageStatusText") or "")
  provider["limits"] = [
    limit(label, data.get(percent_key), data.get(reset_key))
    for label, percent_key, reset_key in limit_keys
    if normalized_percent(data.get(percent_key)) >= 0
  ]
  return provider


def codex_provider(_: dict[str, Any]) -> dict[str, Any]:
  scanner = runtime_root() / "shell" / "plugins" / "model-usage" / "scripts" / "codex_usage_scanner.py"
  return scanner_provider(
    "codex",
    "Codex",
    [sys.executable, str(scanner)],
    [
      ("Session", "rateLimitPercent", "rateLimitResetAt"),
      ("Weekly", "secondaryRateLimitPercent", "secondaryRateLimitResetAt"),
    ],
  )


def opencode_provider(settings: dict[str, Any]) -> dict[str, Any]:
  scanner = runtime_root() / "shell" / "plugins" / "model-usage" / "scripts" / "opencode_go_usage_scanner.py"
  database = expand_path(settings.get("databasePath", "~/.local/share/opencode/opencode.db"))
  auth = expand_path(settings.get("authPath", "~/.local/share/opencode/auth.json"))
  return scanner_provider(
    "opencode-go",
    "OpenCode Go",
    [sys.executable, str(scanner), str(database), str(auth)],
    [
      ("5-hour", "rateLimitPercent", "rateLimitResetAt"),
      ("Weekly", "secondaryRateLimitPercent", "secondaryRateLimitResetAt"),
      ("Monthly", "tertiaryRateLimitPercent", "tertiaryRateLimitResetAt"),
    ],
  )


def fetch_data(force: bool = False) -> dict[str, Any]:
  if not force:
    try:
      cached = json.loads(CACHE_PATH.read_text(encoding="utf-8"))
      age = dt.datetime.now().timestamp() - number(cached.get("updatedAt"), 0)
      if age >= 0 and age < CACHE_SECONDS and isinstance(cached.get("providers"), list):
        return cached
    except (OSError, json.JSONDecodeError):
      pass

  settings = read_shell_settings()
  tasks = {
    "claude": (claude_provider, provider_settings("claude", settings)),
    "codex": (codex_provider, provider_settings("codex", settings)),
    "opencode-go": (opencode_provider, provider_settings("opencode-go", settings)),
  }
  providers: list[dict[str, Any]] = []
  with concurrent.futures.ThreadPoolExecutor(max_workers=3) as executor:
    futures = {
      provider_id: executor.submit(function, provider_config)
      for provider_id, (function, provider_config) in tasks.items()
      if provider_config.get("enabled", True) is not False
    }
    for provider_id in tasks:
      if provider_id not in futures:
        continue
      try:
        providers.append(futures[provider_id].result())
      except Exception:
        providers.append(base_provider(provider_id, provider_id))
        providers[-1]["status"] = f"{providers[-1]['name']} unavailable"

  data = {"schemaVersion": 1, "updatedAt": dt.datetime.now().timestamp(), "providers": providers}
  CACHE_PATH.parent.mkdir(parents=True, exist_ok=True)
  with tempfile.NamedTemporaryFile("w", dir=CACHE_PATH.parent, delete=False, encoding="utf-8") as temporary:
    json.dump(data, temporary, separators=(",", ":"))
    temporary.write("\n")
    temporary_path = Path(temporary.name)
  temporary_path.replace(CACHE_PATH)
  return data


def reset_text(reset_at: str) -> str:
  if not reset_at:
    return ""
  try:
    raw = str(reset_at)
    if raw.isdigit():
      timestamp = float(raw)
      if timestamp > 10_000_000_000:
        timestamp /= 1000
      reset = dt.datetime.fromtimestamp(timestamp, tz=dt.timezone.utc)
    else:
      reset = dt.datetime.fromisoformat(raw.replace("Z", "+00:00"))
      if reset.tzinfo is None:
        reset = reset.replace(tzinfo=dt.datetime.now().astimezone().tzinfo)
    seconds = max(0, int((reset - dt.datetime.now(reset.tzinfo)).total_seconds()))
  except (TypeError, ValueError, OverflowError, OSError):
    return ""

  minutes = seconds // 60
  hours = minutes // 60
  days = hours // 24
  if days:
    return f"resets {days}d {hours % 24}h"
  if hours:
    return f"resets {hours}h {minutes % 60}m"
  return f"resets {max(1, minutes)}m"


def token_text(value: Any) -> str:
  tokens = max(0, number(value))
  if tokens >= 1_000_000_000:
    return f"{tokens / 1_000_000_000:.1f}B"
  if tokens >= 1_000_000:
    return f"{tokens / 1_000_000:.1f}M"
  if tokens >= 1_000:
    return f"{tokens / 1_000:.1f}K"
  return str(round(tokens))


def provider_lines(provider: dict[str, Any]) -> list[str]:
  heading = provider.get("name", "Provider")
  if provider.get("tier"):
    heading += f" · {provider['tier']}"
  lines = [heading]
  for window in provider.get("limits", []):
    percent = normalized_percent(window.get("percent"))
    if percent < 0:
      continue
    used = round(percent * 100)
    reset = reset_text(str(window.get("resetAt") or ""))
    suffix = f" · {reset}" if reset else ""
    lines.append(f"  {window.get('label', 'Limit')}: {used}% used · {100 - used}% left{suffix}")
  status = str(provider.get("status") or "").strip()
  if status:
    lines.append(f"  {status}")
  elif not provider.get("limits"):
    lines.append("  No signed-in usage data")
  lines.append(
    f"  Today: {token_text(provider.get('todayTokens'))} tokens · "
    f"{max(0, integer(provider.get('todayPrompts')))} prompts",
  )
  return lines


def details_text(data: dict[str, Any]) -> str:
  lines: list[str] = []
  for provider in data.get("providers", []):
    lines.extend(provider_lines(provider))
    lines.append("")
  updated = dt.datetime.fromtimestamp(number(data.get("updatedAt"), 0)).astimezone()
  lines.append(f"Updated {updated.strftime('%H:%M:%S')}")
  return "\n".join(lines).rstrip()


def rendered_output(data: dict[str, Any]) -> str:
  providers = data.get("providers", [])
  percents = [
    normalized_percent(window.get("percent"))
    for provider in providers
    for window in provider.get("limits", [])
    if normalized_percent(window.get("percent")) >= 0
  ]
  summary = "AI usage" if not percents else f"AI {round((1 - max(percents)) * 100)}% left"
  tooltip = details_text(data)
  click_command = shlex.quote(str(SCRIPT_PATH)) + " details"
  return (
    f"<txt>{html.escape(summary, quote=False)}</txt>"
    f"<tool>{html.escape(tooltip, quote=False)}</tool>"
    f"<txtclick>{html.escape(click_command, quote=False)}</txtclick>"
  )


def show_details(data: dict[str, Any]) -> int:
  content = details_text(data)
  dialog = SCRIPT_PATH.parent / "xfce-model-usage-dialog"
  if dialog.is_file():
    result = subprocess.run(
      [str(dialog)],
      input=content,
      text=True,
      check=False,
    )
    if result.returncode == 0:
      return 0
  print(content)
  return 0


def main() -> int:
  parser = argparse.ArgumentParser()
  parser.add_argument("action", nargs="?", choices=("render", "details", "refresh"), default="render")
  args = parser.parse_args()
  data = fetch_data(force=args.action == "refresh")
  if args.action == "details":
    return show_details(data)
  if args.action == "refresh":
    print(details_text(data))
  else:
    print(rendered_output(data))
  return 0


if __name__ == "__main__":
  raise SystemExit(main())
