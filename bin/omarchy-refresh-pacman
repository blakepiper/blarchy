#!/bin/bash

# omarchy:summary=Refresh Arch package databases using the user's pacman configuration.
# omarchy:requires-sudo=true

set -euo pipefail

# RICE never replaces pacman.conf or the mirrorlist. The user owns repository
# and mirror choices on the Arch installation they created.
omarchy-hook pre-refresh-pacman
sudo env OMARCHY_UPDATE_PACMAN=1 pacman -Syyuu --noconfirm \
  --ignore omarchy,omarchy-dev,omarchy-settings,omarchy-settings-dev
