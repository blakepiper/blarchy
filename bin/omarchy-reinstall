#!/bin/bash

# omarchy:summary=Reinstall BLARCHY packages and reset default configs

set -euo pipefail

echo -e "This will reinstall all default BLARCHY packages and reset default configs.\nWarning: user config changes will be overwritten.\n"

if gum confirm "Are you sure you want to reinstall and lose config changes?"; then
  omarchy-reinstall-pkgs
  omarchy-reinstall-configs

  gum confirm "System has been reinstalled. Reboot?" && omarchy-system-reboot
fi
