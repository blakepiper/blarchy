#!/bin/bash

# omarchy:summary=Update and ensure all default BLARCHY packages are installed

set -euo pipefail

install_config="${BLARCHY_INSTALL_CONFIG:-/etc/blarchy.conf}"
if [[ -r $install_config ]]; then
  source "$install_config"
fi

source_path=${BLARCHY_SOURCE_PATH:-}
if [[ -z $source_path || ! -f $source_path/install.sh ]]; then
  echo "BLARCHY_SOURCE_PATH is not configured; run install.sh from your BLARCHY checkout." >&2
  exit 1
fi

exec bash "$source_path/install.sh"
