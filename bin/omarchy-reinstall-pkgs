#!/bin/bash

# omarchy:summary=Update and ensure all default BLARCHY packages are installed
# omarchy:requires-sudo=true

set -e

# Refresh package metadata and update Arch/AUR-repository packages while the
# refresh command protects Git-owned BLARCHY content packages.
omarchy-refresh-pacman

# Ensure all manifest packages are installed without changing package versions
# arbitrarily or globally updating npm packages.
mapfile -t packages < <(grep -v '^#' "$OMARCHY_PATH/install/omarchy-base.packages" | grep -v '^$')
omarchy-pkg-add "${packages[@]}"
