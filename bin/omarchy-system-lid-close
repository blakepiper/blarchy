#!/bin/bash

# omarchy:summary=Lock and reconcile displays when the laptop lid closes
# omarchy:group=system
# omarchy:hidden=true

# logind is configured to leave lid handling to this compositor binding. That
# lets us reject transient firmware lid events before they lock or suspend the
# session. Once the lid stays closed, lock immediately and request suspend;
# omarchy-system-sleep-lock then remains the safety net for the lock race.
#
# A docked lid close does not suspend (HandleLidSwitchDocked defaults to
# ignore), so it must not lock either: that is clamshell mode, still in use on
# the external display.
lid_stayed_closed() {
  local check

  for check in 1 2; do
    omarchy-hw-laptop-closed || return 1
    sleep 0.15
  done
}

suspend_after_sync=0
if omarchy-hw-laptop-closed && ! omarchy-hw-external-monitors && lid_stayed_closed; then
  omarchy-system-lock >/dev/null 2>&1 || true
  suspend_after_sync=1
fi

omarchy-hyprland-monitor-clamshell

if (( suspend_after_sync )); then
  systemctl suspend
fi
