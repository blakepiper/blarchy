#!/bin/bash

# omarchy:summary=Shut down after closing application windows
# omarchy:examples=omarchy shutdown | omarchy system shutdown
# omarchy:aliases=omarchy shutdown

# Authenticate before closing windows, while the caller still belongs to the
# active session. The delayed action itself runs as a system unit so it does
# not lose its authorization when the launching terminal is closed.
if [[ -t 0 && -t 1 ]]; then
  sudo systemd-run --system --collect --quiet --on-active="2s" \
    --timer-property=AccuracySec=100ms systemctl poweroff --no-wall || exit 1
else
  pkexec systemd-run --system --collect --quiet --on-active="2s" \
    --timer-property=AccuracySec=100ms systemctl poweroff --no-wall || exit 1
fi

omarchy-osd -i shutdown -m "Shutting down" -d 5000

omarchy-state clear re*-required

# Now close all windows
omarchy-hyprland-window-close-all
sleep 1 # Allow apps like Chrome to shutdown correctly
