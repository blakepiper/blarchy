#!/bin/bash

# omarchy:summary=Update Arch and AUR packages with yay
# omarchy:args=[yay options...]
# omarchy:examples=omarchy update | omarchy update --devel

set -euo pipefail

# Compatibility route only. BLARCHY does not wrap the Arch update lifecycle or
# pull its Git checkout as a side effect of updating packages.
exec yay -Syu "$@"
