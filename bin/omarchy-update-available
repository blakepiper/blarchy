#!/bin/bash

# omarchy:summary=Check whether Arch or AUR package updates are available
# omarchy:hidden=true

set -euo pipefail

repo_updates=$(checkupdates 2>/dev/null || true)
aur_updates=$(yay -Qua 2>/dev/null || true)

if [[ -n $repo_updates || -n $aur_updates ]]; then
  [[ -n $repo_updates ]] && printf '%s\n' "$repo_updates"
  [[ -n $aur_updates ]] && printf '%s\n' "$aur_updates"
  exit 0
fi

echo "System packages are up to date"
exit 1
