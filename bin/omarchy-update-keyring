#!/bin/bash

# omarchy:summary=Ensure the Arch signing keyring is current
# omarchy:hidden=true
# omarchy:requires-sudo=true

# Reinstall before the full system transaction so newly rotated Arch signing
# keys are available. BLARCHY has no private package repository or keyring.
echo -e "\e[32m\nUpdate Arch signing keys\e[0m"
sudo pacman -Sy --noconfirm archlinux-keyring >/dev/null \
  2> >(grep -vE '^warning: archlinux-keyring-[^ ]+ is up to date -- reinstalling$' >&2)
echo "Keys are correct"
