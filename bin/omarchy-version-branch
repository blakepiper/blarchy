#!/bin/bash

# omarchy:summary=Print the active BLARCHY source branch
# omarchy:hidden=true

omarchy_path=${BLARCHY_PATH:-${OMARCHY_PATH:-/usr/local/share/blarchy}}
omarchy_path=${omarchy_path%/}

[[ -d $omarchy_path/.git ]] || exit 1

branch=$(git -C "$omarchy_path" branch --show-current 2>/dev/null || true)
if [[ -z $branch ]]; then
  hash=$(git -C "$omarchy_path" rev-parse --short HEAD 2>/dev/null || true)
  [[ -n $hash ]] || exit 1
  branch="detached@$hash"
fi

echo "$branch"
