#!/bin/bash

# omarchy:summary=Render and toggle the XFCE Stay Awake panel widget
# omarchy:group=bar
# omarchy:hidden=true
# omarchy:args=[toggle|stay-awake|allow-idle|status]

set -u

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/indicators"
state_file="$state_dir/stay-awake"
pid_file="$state_dir/stay-awake-xfce.pid"
power_mode_backup="$state_dir/stay-awake-xfce-power-mode"
lock_file="$state_dir/stay-awake-xfce.lock"
power_channel=xfce4-power-manager
power_property=/xfce4-power-manager/presentation-mode

script_path=$(readlink -f "$0")
script_dir=$(dirname "$script_path")
runtime_path="${RICE_PATH:-${OMARCHY_PATH:-$(cd -- "$script_dir/.." && pwd)}}"
icon_dir="$runtime_path/default/omarchy/icons"
if [[ ! -f $icon_dir/caffeine-cup-full-white.svg ]]; then
  icon_dir="$HOME/.local/share/omarchy/icons"
fi
active_icon="$icon_dir/caffeine-cup-full-white.svg"
inactive_icon="$icon_dir/caffeine-cup-empty-white.svg"

power_mode_value() {
  xfconf-query -c "$power_channel" -p "$power_property" 2>/dev/null || true
}

save_power_mode() {
  local current

  [[ -f $power_mode_backup ]] && return

  current=$(power_mode_value)
  if [[ $current == "true" || $current == "false" ]]; then
    printf 'present\n%s\n' "$current" >"$power_mode_backup"
  else
    printf 'absent\n' >"$power_mode_backup"
  fi
}

enable_power_mode() {
  local current

  save_power_mode
  current=$(power_mode_value)
  [[ $current == "true" ]] ||
    xfconf-query -c "$power_channel" -p "$power_property" -n -t bool -s true
}

restore_power_mode() {
  local marker value

  [[ -f $power_mode_backup ]] || return
  read -r marker <"$power_mode_backup"

  if [[ $marker == "present" ]]; then
    value=$(sed -n '2p' "$power_mode_backup")
    xfconf-query -c "$power_channel" -p "$power_property" -n -t bool -s "$value"
  else
    xfconf-query -c "$power_channel" -p "$power_property" -r 2>/dev/null || true
  fi

  rm -f -- "$power_mode_backup"
}

worker_is_running() {
  local pid

  [[ -r $pid_file ]] || return 1
  read -r pid <"$pid_file" || return 1
  [[ $pid =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null
}

stop_worker() {
  local pid

  if [[ -r $pid_file ]]; then
    read -r pid <"$pid_file" || pid=""
    if [[ $pid =~ ^[0-9]+$ ]]; then
      kill "$pid" 2>/dev/null || true
    fi
  fi

  rm -f -- "$pid_file"
}

run_worker() {
  local screensaver_pid inhibit_pid cleaned=0

  exec 9>&-
  [[ -f $state_file ]] || exit 0

  xfce4-screensaver-command \
    --inhibit \
    --application-name "Coffee" \
    --reason "Stay Awake" \
    >/dev/null 2>&1 &
  screensaver_pid=$!

  systemd-inhibit \
    --what=idle \
    --mode=block \
    --who=Coffee \
    --why="Stay Awake" \
    sleep infinity \
    >/dev/null 2>&1 &
  inhibit_pid=$!

  cleanup() {
    (( cleaned == 1 )) && return
    cleaned=1
    kill "$screensaver_pid" "$inhibit_pid" 2>/dev/null || true
    wait "$screensaver_pid" "$inhibit_pid" 2>/dev/null || true
  }

  trap cleanup EXIT HUP INT TERM

  while [[ -f $state_file ]]; do
    sleep 2
  done
}

start_worker() {
  local worker_pid

  worker_is_running && return
  rm -f -- "$pid_file"
  "$script_path" --worker >/dev/null 2>&1 &
  worker_pid=$!
  printf '%s\n' "$worker_pid" >"$pid_file"
}

print_widget() {
  local click_command="env RICE_PATH=$runtime_path $script_path toggle"

  if [[ -f $state_file ]]; then
    enable_power_mode
    start_worker
    printf '<img>%s</img><click>%s</click><tool>Allow Idle Lock and Screensaver</tool>\n' "$active_icon" "$click_command"
  else
    stop_worker
    printf '<img>%s</img><click>%s</click><tool>Stay Awake</tool>\n' "$inactive_icon" "$click_command"
  fi
}

toggle_state() {
  mkdir -p -- "$state_dir"

  if [[ -f $state_file ]]; then
    rm -f -- "$state_file"
    restore_power_mode
    stop_worker
  else
    save_power_mode
    : >"$state_file"
    enable_power_mode
    start_worker
  fi
}

case ${1:-status} in
  --worker)
    run_worker
    ;;
  toggle)
    mkdir -p -- "$state_dir"
    exec 9>"$lock_file"
    flock -x 9
    toggle_state
    ;;
  status|render)
    mkdir -p -- "$state_dir"
    exec 9>"$lock_file"
    flock -x 9
    print_widget
    ;;
  on|stay-awake)
    mkdir -p -- "$state_dir"
    exec 9>"$lock_file"
    flock -x 9
    if [[ ! -f $state_file ]]; then
      save_power_mode
      : >"$state_file"
    fi
    enable_power_mode
    start_worker
    ;;
  off|allow-idle)
    mkdir -p -- "$state_dir"
    exec 9>"$lock_file"
    flock -x 9
    rm -f -- "$state_file"
    restore_power_mode
    stop_worker
    ;;
  *)
    printf 'Usage: %s [toggle|status|on|off]\n' "$script_path" >&2
    exit 2
    ;;
esac
