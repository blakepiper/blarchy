#!/bin/bash

# omarchy:summary=Render and toggle the XFCE Night Light panel widget
# omarchy:group=bar
# omarchy:hidden=true
# omarchy:args=[toggle|nightlight|daylight|status]

set -u

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/indicators"
state_file="$state_dir/nightlight-xfce"
overlay_pid_file="$state_dir/nightlight-xfce-overlay.pid"
lock_file="$state_dir/nightlight-xfce.lock"
night_temperature=4000
day_temperature=6500

script_path=$(readlink -f "$0")
script_dir=$(dirname "$script_path")
runtime_path="${RICE_PATH:-${OMARCHY_PATH:-$(cd -- "$script_dir/.." && pwd)}}"
icon_dir="$runtime_path/default/omarchy/icons"
if [[ ! -f $icon_dir/nightlight-full-white.svg ]]; then
  icon_dir="$HOME/.local/share/omarchy/icons"
fi
active_icon="$icon_dir/nightlight-full-white.svg"
inactive_icon="$icon_dir/nightlight-empty-white.svg"
overlay_path="$runtime_path/bin/omarchy-xfce-nightlight-overlay"
if [[ ! -x $overlay_path ]]; then
  overlay_path="$script_dir/omarchy-xfce-nightlight-overlay"
fi

overlay_is_running() {
  local pid

  [[ -r $overlay_pid_file ]] || return 1
  read -r pid <"$overlay_pid_file" || return 1
  [[ $pid =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null
}

start_overlay() {
  local overlay_pid

  overlay_is_running && return
  [[ -x $overlay_path ]] || return 1
  rm -f -- "$overlay_pid_file"
  "$overlay_path" >/dev/null 2>&1 9>&- &
  overlay_pid=$!
  printf '%s\n' "$overlay_pid" >"$overlay_pid_file"
}

stop_overlay() {
  local pid still_running

  if [[ -r $overlay_pid_file ]]; then
    read -r pid <"$overlay_pid_file" || pid=""
    if [[ $pid =~ ^[0-9]+$ ]]; then
      kill "$pid" 2>/dev/null || true
      still_running=true
      for _ in {1..10}; do
        if ! kill -0 "$pid" 2>/dev/null; then
          still_running=false
          break
        fi
        sleep 0.1
      done
      [[ $still_running == "true" ]] && kill -9 "$pid" 2>/dev/null || true
    fi
  fi

  rm -f -- "$overlay_pid_file"
}

status_json() {
  if [[ -f $state_file ]]; then
    printf '{"enabled":true,"temperature":%s}\n' "$night_temperature"
  else
    printf '{"enabled":false,"temperature":%s}\n' "$day_temperature"
  fi
}

print_widget() {
  local click_command="env RICE_PATH=$runtime_path $script_path toggle"

  if [[ -f $state_file ]]; then
    start_overlay || true
    printf '<img>%s</img><click>%s</click><tool>Day Light</tool>\n' "$active_icon" "$click_command"
  else
    stop_overlay
    printf '<img>%s</img><click>%s</click><tool>Night Light</tool>\n' "$inactive_icon" "$click_command"
  fi
}

toggle_state() {
  mkdir -p -- "$state_dir"

  if [[ -f $state_file ]]; then
    rm -f -- "$state_file"
    stop_overlay
  else
    : >"$state_file"
    start_overlay || {
      rm -f -- "$state_file"
      return 1
    }
  fi
}

case ${1:-status} in
  --status|status)
    mkdir -p -- "$state_dir"
    exec 9>"$lock_file"
    flock -x 9
    if [[ ${1:-} == "--status" ]]; then
      status_json
    else
      print_widget
    fi
    ;;
  toggle)
    mkdir -p -- "$state_dir"
    exec 9>"$lock_file"
    flock -x 9
    toggle_state
    ;;
  nightlight|on)
    mkdir -p -- "$state_dir"
    exec 9>"$lock_file"
    flock -x 9
    : >"$state_file"
    start_overlay || {
      rm -f -- "$state_file"
      exit 1
    }
    ;;
  daylight|off)
    mkdir -p -- "$state_dir"
    exec 9>"$lock_file"
    flock -x 9
    rm -f -- "$state_file"
    stop_overlay
    ;;
  *)
    printf 'Usage: %s [toggle|nightlight|daylight|status]\n' "$script_path" >&2
    exit 2
    ;;
esac
