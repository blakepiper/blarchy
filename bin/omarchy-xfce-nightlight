#!/bin/bash

# omarchy:summary=Render and toggle the XFCE Night Light panel widget
# omarchy:group=bar
# omarchy:hidden=true
# omarchy:args=[toggle|on|off|status]

set -euo pipefail

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/indicators"
state_file="$state_dir/nightlight-xfce"
lock_file="$state_dir/nightlight-xfce.lock"
night_temperature=3500

script_path=$(readlink -f "$0")
script_dir=$(dirname "$script_path")
runtime_path="${RICE_PATH:-${OMARCHY_PATH:-$(cd -- "$script_dir/.." && pwd)}}"
icon_dir="$runtime_path/default/omarchy/icons"
if [[ ! -f $icon_dir/nightlight-full-white.svg ]]; then
  icon_dir="$HOME/.local/share/omarchy/icons"
fi
active_icon="$icon_dir/nightlight-full-white.svg"
inactive_icon="$icon_dir/nightlight-empty-white.svg"

render_widget() {
  local click_command

  printf -v click_command 'env RICE_PATH=%q %q toggle' "$runtime_path" "$script_path"
  if [[ -f $state_file ]]; then
    printf '<img>%s</img><click>%s</click><tool>Night Light: %sK (click to turn off)</tool>\n' \
      "$active_icon" "$click_command" "$night_temperature"
  else
    printf '<img>%s</img><click>%s</click><tool>Night Light: off (click to turn on)</tool>\n' \
      "$inactive_icon" "$click_command"
  fi
}

turn_on() {
  gammastep -O "$night_temperature"
  : >"$state_file"
}

turn_off() {
  gammastep -x
  rm -f -- "$state_file"
}

toggle() {
  if [[ -f $state_file ]]; then
    turn_off
  else
    turn_on
  fi
}

mkdir -p -- "$state_dir"
exec 9>"$lock_file"
flock -x 9

case ${1:-status} in
  status|render)
    render_widget
    ;;
  toggle)
    toggle
    ;;
  on)
    turn_on
    ;;
  off)
    turn_off
    ;;
  *)
    printf 'Usage: %s [toggle|on|off|status]\n' "$script_path" >&2
    exit 2
    ;;
esac
