#!/usr/bin/env python3

# omarchy:summary=Render the XFCE Night Light click-through overlay
# omarchy:group=bar
# omarchy:hidden=true

import ctypes
import array
import signal
import sys
import time


Display = ctypes.c_void_p
Window = ctypes.c_ulong
Atom = ctypes.c_ulong
Visual = ctypes.c_void_p

TrueColor = 4
AllocNone = 0
InputOutput = 1
CWBorderPixel = 1 << 3
CWBackPixel = 1 << 1
CWOverrideRedirect = 1 << 9
CWColormap = 1 << 13
PropModeReplace = 0
ShapeInput = 2
ShapeSet = 0
YXBanded = 0
ClientMessage = 33
SubstructureNotifyMask = 1 << 19
SubstructureRedirectMask = 1 << 20
ZPixmap = 2


class XVisualInfo(ctypes.Structure):
  _fields_ = [
    ("visual", Visual),
    ("visualid", ctypes.c_ulong),
    ("screen", ctypes.c_int),
    ("depth", ctypes.c_int),
    ("visual_class", ctypes.c_int),
    ("red_mask", ctypes.c_ulong),
    ("green_mask", ctypes.c_ulong),
    ("blue_mask", ctypes.c_ulong),
    ("colormap_size", ctypes.c_int),
    ("bits_per_rgb", ctypes.c_int),
  ]


class XSetWindowAttributes(ctypes.Structure):
  _fields_ = [
    ("background_pixmap", ctypes.c_ulong),
    ("background_pixel", ctypes.c_ulong),
    ("border_pixmap", ctypes.c_ulong),
    ("border_pixel", ctypes.c_ulong),
    ("bit_gravity", ctypes.c_int),
    ("win_gravity", ctypes.c_int),
    ("backing_store", ctypes.c_int),
    ("backing_planes", ctypes.c_ulong),
    ("backing_pixel", ctypes.c_ulong),
    ("save_under", ctypes.c_int),
    ("event_mask", ctypes.c_long),
    ("do_not_propagate_mask", ctypes.c_long),
    ("override_redirect", ctypes.c_int),
    ("colormap", ctypes.c_ulong),
    ("cursor", ctypes.c_ulong),
  ]


class XClientMessageData(ctypes.Union):
  _fields_ = [("l", ctypes.c_long * 5)]


class XClientMessageEvent(ctypes.Structure):
  _fields_ = [
    ("type", ctypes.c_int),
    ("serial", ctypes.c_ulong),
    ("send_event", ctypes.c_int),
    ("display", Display),
    ("window", Window),
    ("message_type", Atom),
    ("format", ctypes.c_int),
    ("data", XClientMessageData),
  ]


x11 = ctypes.CDLL("libX11.so.6")
xext = ctypes.CDLL("libXext.so.6")

x11.XOpenDisplay.argtypes = [ctypes.c_char_p]
x11.XOpenDisplay.restype = Display
x11.XDefaultScreen.argtypes = [Display]
x11.XDefaultScreen.restype = ctypes.c_int
x11.XRootWindow.argtypes = [Display, ctypes.c_int]
x11.XRootWindow.restype = Window
x11.XDisplayWidth.argtypes = [Display, ctypes.c_int]
x11.XDisplayWidth.restype = ctypes.c_int
x11.XDisplayHeight.argtypes = [Display, ctypes.c_int]
x11.XDisplayHeight.restype = ctypes.c_int
x11.XMatchVisualInfo.argtypes = [Display, ctypes.c_int, ctypes.c_int, ctypes.c_int, ctypes.POINTER(XVisualInfo)]
x11.XMatchVisualInfo.restype = ctypes.c_int
x11.XCreateColormap.argtypes = [Display, Window, Visual, ctypes.c_int]
x11.XCreateColormap.restype = ctypes.c_ulong
x11.XCreateWindow.argtypes = [
  Display,
  Window,
  ctypes.c_int,
  ctypes.c_int,
  ctypes.c_uint,
  ctypes.c_uint,
  ctypes.c_uint,
  ctypes.c_int,
  ctypes.c_uint,
  Visual,
  ctypes.c_ulong,
  ctypes.POINTER(XSetWindowAttributes),
]
x11.XCreateWindow.restype = Window
x11.XInternAtom.argtypes = [Display, ctypes.c_char_p, ctypes.c_int]
x11.XInternAtom.restype = Atom
x11.XChangeProperty.argtypes = [
  Display,
  Window,
  Atom,
  Atom,
  ctypes.c_int,
  ctypes.c_int,
  ctypes.c_void_p,
  ctypes.c_int,
]
x11.XChangeProperty.restype = ctypes.c_int
x11.XMapRaised.argtypes = [Display, Window]
x11.XMapRaised.restype = ctypes.c_int
x11.XCreateGC.argtypes = [Display, Window, ctypes.c_ulong, ctypes.c_void_p]
x11.XCreateGC.restype = ctypes.c_void_p
x11.XPutImage.argtypes = [
  Display,
  Window,
  ctypes.c_void_p,
  ctypes.c_void_p,
  ctypes.c_int,
  ctypes.c_int,
  ctypes.c_int,
  ctypes.c_int,
  ctypes.c_uint,
  ctypes.c_uint,
]
x11.XPutImage.restype = ctypes.c_int
x11.XFreeGC.argtypes = [Display, ctypes.c_void_p]
x11.XFreeGC.restype = ctypes.c_int
x11.XCreateImage.argtypes = [
  Display,
  Visual,
  ctypes.c_uint,
  ctypes.c_int,
  ctypes.c_int,
  ctypes.c_char_p,
  ctypes.c_uint,
  ctypes.c_uint,
  ctypes.c_int,
  ctypes.c_int,
]
x11.XCreateImage.restype = ctypes.c_void_p
x11.XSendEvent.argtypes = [Display, Window, ctypes.c_int, ctypes.c_long, ctypes.c_void_p]
x11.XSendEvent.restype = ctypes.c_int
x11.XRaiseWindow.argtypes = [Display, Window]
x11.XRaiseWindow.restype = ctypes.c_int
x11.XUnmapWindow.argtypes = [Display, Window]
x11.XUnmapWindow.restype = ctypes.c_int
x11.XDestroyWindow.argtypes = [Display, Window]
x11.XDestroyWindow.restype = ctypes.c_int
x11.XFlush.argtypes = [Display]
x11.XFlush.restype = ctypes.c_int
x11.XCloseDisplay.argtypes = [Display]
x11.XCloseDisplay.restype = ctypes.c_int

xext.XShapeCombineRectangles.argtypes = [
  Display,
  Window,
  ctypes.c_int,
  ctypes.c_int,
  ctypes.c_int,
  ctypes.c_void_p,
  ctypes.c_int,
  ctypes.c_int,
  ctypes.c_int,
]
xext.XShapeCombineRectangles.restype = None


display = None
window = Window(0)


def atom(name):
  return x11.XInternAtom(display, name.encode(), 0)


def set_atom_list(property_name, names):
  values = (Atom * len(names))(*(atom(name) for name in names))
  x11.XChangeProperty(
    display,
    window,
    atom(property_name),
    atom("ATOM"),
    32,
    PropModeReplace,
    ctypes.cast(values, ctypes.c_void_p),
    len(names),
  )


def set_cardinal(property_name, value):
  values = (ctypes.c_uint32 * 1)(value)
  x11.XChangeProperty(
    display,
    window,
    atom(property_name),
    atom("CARDINAL"),
    32,
    PropModeReplace,
    ctypes.cast(values, ctypes.c_void_p),
    1,
  )


def request_wm_state(root, state_atoms):
  event = XClientMessageEvent()
  event.type = ClientMessage
  event.send_event = 1
  event.display = display
  event.window = window
  event.message_type = atom("_NET_WM_STATE")
  event.format = 32
  event.data.l[0] = 1
  event.data.l[1] = atom(state_atoms[0])
  event.data.l[2] = atom(state_atoms[1]) if len(state_atoms) > 1 else 0
  event.data.l[3] = 1
  x11.XSendEvent(
    display,
    root,
    0,
    SubstructureNotifyMask | SubstructureRedirectMask,
    ctypes.byref(event),
  )


def cleanup(_signal=None, _frame=None):
  if display and window:
    x11.XUnmapWindow(display, window)
    x11.XDestroyWindow(display, window)
    x11.XFlush(display)
    x11.XCloseDisplay(display)
  raise SystemExit(0)


def main():
  global display, window

  display = x11.XOpenDisplay(None)
  if not display:
    print("Unable to open the X11 display", file=sys.stderr)
    return 1

  screen = x11.XDefaultScreen(display)
  root = x11.XRootWindow(display, screen)
  width = x11.XDisplayWidth(display, screen)
  height = x11.XDisplayHeight(display, screen)

  visual_info = XVisualInfo()
  if not x11.XMatchVisualInfo(display, screen, 32, TrueColor, ctypes.byref(visual_info)):
    print("The X11 server has no 32-bit ARGB visual", file=sys.stderr)
    cleanup()

  colormap = x11.XCreateColormap(display, root, visual_info.visual, AllocNone)
  attributes = XSetWindowAttributes()
  attributes.border_pixel = 0
  attributes.background_pixel = 0
  # Let XFWM manage the window so its above-state is honored over panels and
  # normal windows. The empty input shape keeps the managed window click-through.
  attributes.override_redirect = 0
  attributes.colormap = colormap
  window = x11.XCreateWindow(
    display,
    root,
    0,
    0,
    width,
    height,
    0,
    32,
    InputOutput,
    visual_info.visual,
    CWBackPixel | CWBorderPixel | CWOverrideRedirect | CWColormap,
    ctypes.byref(attributes),
  )
  if not window:
    print("Unable to create the X11 overlay window", file=sys.stderr)
    cleanup()

  set_atom_list("_NET_WM_WINDOW_TYPE", ["_NET_WM_WINDOW_TYPE_NORMAL"])
  set_atom_list(
    "_NET_WM_STATE",
    [
      "_NET_WM_STATE_FULLSCREEN",
      "_NET_WM_STATE_ABOVE",
      "_NET_WM_STATE_STICKY",
      "_NET_WM_STATE_SKIP_TASKBAR",
      "_NET_WM_STATE_SKIP_PAGER",
    ],
  )
  set_cardinal("_NET_WM_WINDOW_OPACITY", 0x33ffffff)

  # An empty input region makes the overlay completely click-through.
  xext.XShapeCombineRectangles(display, window, ShapeInput, 0, 0, None, 0, ShapeSet, YXBanded)

  x11.XMapRaised(display, window)
  # XFWM may reconfigure the managed window while mapping it, so repeat the
  # empty input shape after the map as well as before it.
  xext.XShapeCombineRectangles(display, window, ShapeInput, 0, 0, None, 0, ShapeSet, YXBanded)
  request_wm_state(root, ["_NET_WM_STATE_FULLSCREEN"])
  request_wm_state(root, ["_NET_WM_STATE_ABOVE"])
  request_wm_state(root, ["_NET_WM_STATE_STICKY"])

  pixel = (0xff << 24) | (255 << 16) | (140 << 8)
  pixels = array.array("I", [pixel]) * (width * height)
  image = x11.XCreateImage(
    display,
    visual_info.visual,
    32,
    ZPixmap,
    0,
    ctypes.cast(pixels.buffer_info()[0], ctypes.c_char_p),
    width,
    height,
    32,
    0,
  )
  graphics_context = x11.XCreateGC(display, window, 0, None)
  x11.XPutImage(display, window, graphics_context, image, 0, 0, 0, 0, width, height)
  x11.XFreeGC(display, graphics_context)
  x11.XFlush(display)

  signal.signal(signal.SIGINT, cleanup)
  signal.signal(signal.SIGTERM, cleanup)
  while True:
    time.sleep(1)
    x11.XRaiseWindow(display, window)
    x11.XFlush(display)


if __name__ == "__main__":
  sys.exit(main())
