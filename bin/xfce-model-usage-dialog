#!/usr/bin/python3
"""Show XFCE model usage details in a compact Escape-to-close GTK window."""

from __future__ import annotations

import sys

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, Gtk


def quit_on_escape(_widget: Gtk.Window, event: Gdk.EventKey) -> bool:
  if event.keyval == Gdk.KEY_Escape:
    Gtk.main_quit()
    return True
  return False


def main() -> int:
  window = Gtk.Window(title="AI usage")
  window.set_default_size(720, 520)
  window.set_border_width(0)
  window.connect("delete-event", lambda *_args: Gtk.main_quit())
  window.connect("key-press-event", quit_on_escape)

  style = Gtk.CssProvider()
  style.load_from_data(b"""
    textview, textview.view {
      background-color: #1e1e20;
      color: #eeeeee;
      font-family: monospace;
      font-size: 12pt;
      padding: 0;
    }
  """)
  Gtk.StyleContext.add_provider_for_screen(
    Gdk.Screen.get_default(),
    style,
    Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
  )

  scrolled = Gtk.ScrolledWindow()
  scrolled.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
  scrolled.set_shadow_type(Gtk.ShadowType.NONE)
  scrolled.set_border_width(0)

  view = Gtk.TextView()
  view.set_editable(False)
  view.set_cursor_visible(False)
  view.set_monospace(True)
  view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
  view.set_left_margin(0)
  view.set_right_margin(0)
  view.set_top_margin(0)
  view.set_bottom_margin(0)
  view.get_buffer().set_text(sys.stdin.read())

  scrolled.add(view)
  window.add(scrolled)
  window.show_all()
  Gtk.main()
  return 0


if __name__ == "__main__":
  raise SystemExit(main())
