#!/bin/bash

# This compatibility hook is called only by an explicit `omarchy refresh
# pacman`, before that command refreshes package databases. BLARCHY never
# replaces /etc/pacman.conf or the mirrorlist. Normal `yay -Syu` updates do not
# run this hook; manage custom repositories through ordinary Arch configuration.
#
# The hook runs as the invoking user with a warm sudo cache.
#
# To put it into use, remove .sample from this file name.

# Example: add an Include line above [core] for a custom repo during an explicit
# refresh. This is not needed for normal package updates.
# Maintain the repo entries in /etc/pacman.d/custom-repos.conf yourself.

CONF=/etc/pacman.conf
SNIPPET=/etc/pacman.d/custom-repos.conf
MARKER="Include = $SNIPPET"

[[ -r $SNIPPET ]] || exit 0
grep -qxF "$MARKER" "$CONF" && exit 0

sudo sed -i "0,/^\[core\]/s||$MARKER\n\n[core]|" "$CONF"
