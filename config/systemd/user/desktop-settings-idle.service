[Unit]
Description=Manage the desktop screen-off timer
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=HYPRLAND_INSTANCE_SIGNATURE

[Service]
Type=exec
ExecStart=%h/.local/bin/desktop-settings-apply idle
Restart=on-failure
RestartSec=2
