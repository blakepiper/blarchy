[Unit]
Description=Prevent idle sleep while keep-awake is enabled
PartOf=graphical-session.target

[Service]
Type=exec
ExecStart=/usr/bin/systemd-inhibit --what=idle:sleep:handle-lid-switch --who=Keep-Awake --why=User-session-setting --mode=block /usr/bin/sleep infinity
Restart=on-failure
RestartSec=1
