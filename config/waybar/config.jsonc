{
  "layer": "top",
  "position": "top",
  "height": 32,
  "margin-top": 4,
  "margin-left": 4,
  "margin-right": 4,
  "spacing": 0,
  "modules-left": ["niri/workspaces"],
  "modules-center": ["custom/night-mode", "idle_inhibitor", "clock"],
  "modules-right": ["cpu", "memory", "custom/ai-usage", "pulseaudio", "network", "bluetooth", "battery", "tray"],
  "niri/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "default": "",
      "focused": "",
      "urgent": ""
    }
  },
  "clock": {
    "format": "{:%a %b %d  %H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "cpu": {
    "format": "{usage}% ",
    "tooltip": false
  },
  "memory": {
    "format": "{}% ",
    "tooltip": false
  },
  "custom/ai-usage": {
    "exec": "~/.local/bin/ai-usage --waybar",
    "return-type": "json",
    "interval": 300,
    "max-length": 40,
    "on-click": "kitty --hold --title ai-usage ~/.local/bin/ai-usage details",
    "on-click-right": "~/.local/bin/ai-usage refresh",
    "tooltip": true
  },
  "custom/night-mode": {
    "exec": "~/.local/bin/night-mode status",
    "return-type": "json",
    "interval": 5,
    "signal": 8,
    "on-click": "~/.local/bin/night-mode next",
    "tooltip": true
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  },
  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-bluetooth": "{volume}% {icon}",
    "format-bluetooth-muted": " {icon}",
    "format-muted": "",
    "format-source": "{volume}% ",
    "format-source-muted": "",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""]
    },
    "on-click": "pavucontrol"
  },
  "network": {
    "format-wifi": " {essid}",
    "format-ethernet": "",
    "format-linked": "",
    "format-disconnected": "⚠ offline",
    "format-alt": "{ifname}: {ipaddr}/{cidr}",
    "tooltip-format": "{ifname} via {gwaddr}\n{ipaddr}/{cidr}\nClick to configure",
    "on-click": "~/.local/bin/network-settings"
  },
  "bluetooth": {
    "format": " {status}",
    "format-connected": " {num_connections}",
    "format-no-controller": "",
    "tooltip-format": "{controller_alias}\nClick to configure",
    "tooltip-format-connected": "{device_enumerate}\nClick to configure",
    "on-click": "blueman-manager"
  },
  "battery": {
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% ",
    "format-plugged": "{capacity}% ",
    "format-alt": "{time} {icon}",
    "format-icons": ["", "", "", "", ""],
    "states": {
      "warning": 30,
      "critical": 15
    }
  },
  "tray": {
    "spacing": 8
  }
}
