{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 4,
  "modules-left": ["niri/workspaces"],
  "modules-center": ["custom/night-mode", "idle_inhibitor", "clock"],
  "modules-right": ["custom/ai-usage", "pulseaudio", "network", "battery", "tray"],
  "niri/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "default": "",
      "focused": "",
      "urgent": ""
    }
  },
  "clock": {
    "format": "{:%a %b %d  %H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "custom/ai-usage": {
    "exec": "~/.local/bin/ai-usage --waybar",
    "return-type": "json",
    "interval": 300,
    "on-click": "kitty --title ai-usage ~/.local/bin/ai-usage details",
    "on-click-right": "~/.local/bin/ai-usage refresh",
    "tooltip": true
  },
  "custom/night-mode": {
    "exec": "~/.local/bin/night-mode status",
    "return-type": "json",
    "interval": 5,
    "signal": 8,
    "on-click": "~/.local/bin/night-mode next",
    "tooltip": true
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  },
  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-muted": " muted",
    "format-icons": ["", "", ""],
    "on-click": "pavucontrol"
  },
  "network": {
    "format-wifi": " {essid}",
    "format-ethernet": "󰈀 {ipaddr}",
    "format-disconnected": "󰖪 offline",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}"
  },
  "battery": {
    "format": "{capacity}% {icon}",
    "format-icons": ["", "", "", "", ""],
    "states": {
      "warning": 30,
      "critical": 15
    }
  },
  "tray": {
    "spacing": 8
  }
}
