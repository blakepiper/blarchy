# Single source of truth for OMARCHY_PATH + PATH adjustments. Sourced by:
#   /etc/profile.d/omarchy.sh                 (system login shells)
#   ~/.bashrc BLARCHY bootstrap block         (interactive shells)
#   /usr/share/uwsm/env.d/10-omarchy          (Hyprland session via uwsm)
#   /usr/share/omarchy/default/bash/envs      (bash rc chain; SSH/non-login)

# The standalone installer writes /etc/omarchy.conf with the BLARCHY checkout
# path. Development link commands may temporarily change it. When absent, use
# the compatibility runtime path instead of preserving a stale inherited value.
if [ -f /etc/omarchy.conf ]; then
  . /etc/omarchy.conf
  : "${OMARCHY_PATH:=/usr/share/omarchy}"
else
  OMARCHY_PATH=/usr/share/omarchy
fi
export OMARCHY_PATH

# Prepend when /etc/omarchy.conf points directly at a checkout. If it resolves
# to the compatibility path, /usr/local/bin links installed by BLARCHY already
# expose the commands.
if [ "$OMARCHY_PATH" != /usr/share/omarchy ]; then
  case ":$PATH:" in
    *":${OMARCHY_PATH%/}/bin:"*) ;;
    *) PATH="${OMARCHY_PATH%/}/bin${PATH:+:$PATH}" ;;
  esac
  export PATH
fi
