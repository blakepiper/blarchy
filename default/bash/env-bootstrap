# Single source of truth for BLARCHY_PATH and compatibility aliases. Sourced by:
#   /etc/profile.d/omarchy.sh                 (system login shells)
#   ~/.bashrc BLARCHY bootstrap block         (interactive shells)
#   /usr/share/uwsm/env.d/10-omarchy          (Hyprland session via uwsm)
#   /usr/local/share/blarchy/default/bash/envs (bash rc chain; SSH/non-login)

# Installed systems use the immutable runtime snapshot. Older installations
# can continue to provide /etc/omarchy.conf when /etc/blarchy.conf is absent.
if [ -f /etc/blarchy.conf ]; then
  . /etc/blarchy.conf
fi

if [ -z "${BLARCHY_PATH:-}" ] && [ -f /etc/omarchy.conf ]; then
  . /etc/omarchy.conf
  : "${BLARCHY_PATH:=${OMARCHY_PATH:-/usr/local/share/blarchy}}"
fi

if [ -z "${BLARCHY_PATH:-}" ]; then
  BLARCHY_PATH=/usr/local/share/blarchy
fi

# Explicit development links override only the live runtime. Installation and
# update-source metadata remain intact in /etc/blarchy.conf.
if [ -f /etc/blarchy-dev.conf ]; then
  . /etc/blarchy-dev.conf
fi
export BLARCHY_PATH

# Retained command/config namespace. New runtime code should prefer BLARCHY_PATH.
OMARCHY_PATH=$BLARCHY_PATH
BLARCHY_INSTALL=${BLARCHY_INSTALL:-${BLARCHY_PATH%/}/install}
OMARCHY_INSTALL=${OMARCHY_INSTALL:-$BLARCHY_INSTALL}
export OMARCHY_PATH BLARCHY_INSTALL OMARCHY_INSTALL

# Development runtimes may not have command links in /usr/local/bin.
if [ "$BLARCHY_PATH" != /usr/local/share/blarchy ]; then
  case ":$PATH:" in
    *":${BLARCHY_PATH%/}/bin:"*) ;;
    *) PATH="${BLARCHY_PATH%/}/bin${PATH:+:$PATH}" ;;
  esac
  export PATH
fi
