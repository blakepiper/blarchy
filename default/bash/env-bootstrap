# Single source of truth for RICE_PATH and compatibility aliases. Sourced by:
#   /etc/profile.d/rice.sh                   (system login shells)
#   ~/.bashrc personal rice bootstrap block  (interactive shells)
#   /usr/share/uwsm/env.d/10-rice            (Hyprland session via uwsm)
#   /usr/local/share/rice/default/bash/envs (bash rc chain; SSH/non-login)

# Installed systems use the immutable runtime snapshot.
if [ -f /etc/rice.conf ]; then
  . /etc/rice.conf
fi

if [ -z "${RICE_PATH:-}" ]; then
  RICE_PATH=/usr/local/share/rice
fi

# Explicit development links override only the live runtime. Installation and
# metadata remain intact in /etc/rice.conf.
if [ -f /etc/rice-dev.conf ]; then
  . /etc/rice-dev.conf
fi
export RICE_PATH

# Retained command/config namespace. New runtime code should prefer RICE_PATH.
OMARCHY_PATH=$RICE_PATH
RICE_INSTALL=${RICE_INSTALL:-${RICE_PATH%/}/install}
OMARCHY_INSTALL=${OMARCHY_INSTALL:-$RICE_INSTALL}
export OMARCHY_PATH RICE_INSTALL OMARCHY_INSTALL

# Development runtimes may not have command links in /usr/local/bin.
if [ "$RICE_PATH" != /usr/local/share/rice ]; then
  case ":$PATH:" in
    *":${RICE_PATH%/}/bin:"*) ;;
    *) PATH="${RICE_PATH%/}/bin${PATH:+:$PATH}" ;;
  esac
  export PATH
fi
