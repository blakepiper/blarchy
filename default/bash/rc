: "${OMARCHY_PATH:=/usr/share/omarchy}"

# BLARCHY keeps Bash as its default shell. ble.sh supplies history-backed ghost
# suggestions and syntax-aware completion without changing the user's shell.
if [[ $- == *i* && -r /usr/share/blesh/ble.sh ]]; then
  source -- /usr/share/blesh/ble.sh --attach=none
  ble-face -s auto_complete fg=8
fi

source "$OMARCHY_PATH/default/bash/envs"
source "$OMARCHY_PATH/default/bash/shell"
source "$OMARCHY_PATH/default/bash/aliases"
source "$OMARCHY_PATH/default/bash/functions"
source "$OMARCHY_PATH/default/bash/init"
[[ $- == *i* ]] && bind -f "$OMARCHY_PATH/default/bash/inputrc"

[[ ! ${BLE_VERSION-} ]] || ble-attach
