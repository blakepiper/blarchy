[Unit]
Description=Keep BLARCHY awake while a coding agent runs
After=graphical-session.target
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=/usr/bin/blarchy-agent-keep-awake
ExecStopPost=/usr/bin/blarchy-agent-keep-awake --clear
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
