# Clamp battery charging to prolong battery lifespan. Thresholds in sysfs
# reset on reboot, so this runs once per boot and sets them on every
# battery that exposes the kernel charge-control API (most modern
# ThinkPads, Dells, ASUS, Framework, and LG laptops). Batteries without
# the API are silently skipped.

[Unit]
Description=Clamp battery charge to 80 percent
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/bin/bash /usr/local/lib/blarchy/battery-limit

[Install]
WantedBy=multi-user.target
