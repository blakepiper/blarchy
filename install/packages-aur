# AUR packages, installed through yay so that `yay -Syu` keeps them
# updated like any other package.
#
# One package per line. Trailing "# comment" is allowed.

prettymux-bin # prebuilt prettymux terminal multiplexer (yay -Syu updates it)
vscodium-bin # VS Code without Microsoft telemetry (`codium` command)
claude-code # Anthropic's Claude Code agent CLI (`claude` command)
openai-codex-bin # OpenAI Codex CLI (`codex` command)
oh-my-pi-bin # pi coding agent with IDE integration (`pi` command)
opencode-bin # OpenCode agent CLI (`opencode` command)
