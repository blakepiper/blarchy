#!/bin/bash

# Smoke test for the blarchy installer. Runs on any machine with bash
# and python3; no Arch system required.
#
# Usage: ./test/smoke

set -euo pipefail

repo_path=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
failures=0

check() {
  local description="$1"
  shift
  if "$@" >/dev/null 2>&1; then
    printf 'ok: %s\n' "$description"
  else
    printf 'FAIL: %s\n' "$description"
    failures=$((failures + 1))
  fi
}

check_fail() {
  local description="$1"
  shift
  if "$@" >/dev/null 2>&1; then
    printf 'FAIL: %s\n' "$description"
    failures=$((failures + 1))
  else
    printf 'ok: %s\n' "$description"
  fi
}

# Installer scripts parse.
check "install.sh parses" bash -n "$repo_path/install.sh"
for leaf in hardware.sh system.sh user.sh pam.sh; do
  check "install/$leaf parses" bash -n "$repo_path/install/$leaf"
done
if command -v shellcheck >/dev/null 2>&1; then
  check "shellcheck install.sh" shellcheck -S warning "$repo_path/install.sh"
  check "shellcheck install leaves" shellcheck -S warning \
    "$repo_path/install/hardware.sh" \
    "$repo_path/install/system.sh" \
    "$repo_path/install/user.sh" \
    "$repo_path/install/pam.sh"
else
  printf 'skip: shellcheck not installed\n'
fi

# Package manifests are non-empty and carry no removed desktop's packages.
for manifest in packages packages-aur; do
  check "install/$manifest is non-empty" test -s "$repo_path/install/$manifest"
done
check_fail "no hyprland packages" grep -qi -E 'hypr|xfce|alacritty|sddm|quickshell' "$repo_path/install/packages"
check "kitty in packages" grep -qx 'kitty' "$repo_path/install/packages"
check "niri in packages" grep -qx 'niri' "$repo_path/install/packages"
check "waybar in packages" grep -qx 'waybar' "$repo_path/install/packages"
check "fuzzel in packages" grep -qx 'fuzzel' "$repo_path/install/packages"
check "prettymux in AUR list" grep -q 'prettymux' "$repo_path/install/packages-aur"
check "blesh in AUR list" grep -q '^blesh-git\( #.*\)\?$' "$repo_path/install/packages-aur"
check "yay checks development updates by default" grep -q '^yay -Y --devel --save$' "$repo_path/install.sh"
check "kitty opens the configured Bash shell" grep -qx 'shell /bin/bash' "$repo_path/config/kitty/kitty.conf"
check "blesh config parses" bash -n "$repo_path/config/blesh/init.sh"
check_fail "vscodium absent from AUR list" grep -qi -E 'vscodium|codium' "$repo_path/install/packages-aur"
check "terminal-code has an upstream installer" grep -q 'https://tode.sh/install' "$repo_path/install.sh"
check "terminal-code has a separate update path" grep -q 'tode --upgrade' "$repo_path/install.sh"
for agent in claude-code openai-codex-bin oh-my-pi-bin opencode-bin; do
  check "$agent in AUR list" grep -qx "$agent\( #.*\)\?" "$repo_path/install/packages-aur"
done

# Compositor and bar configs exist and look structurally sound.
check "niri config exists" test -f "$repo_path/config/niri/config.kdl"
check "niri desktop bindings" python3 -c "
import sys
text = open('$repo_path/config/niri/config.kdl').read()
assert 'spawn \"kitty\"' in text, 'kitty spawn missing'
assert 'spawn \"fuzzel\"' in text, 'fuzzel spawn missing'
assert 'spawn-sh \"~/.local/bin/tode\"' in text, 'terminal-code spawn missing'
assert 'Mod+Shift+S { screenshot; }' in text, 'native screenshot binding missing'
assert 'cliphist store' in text, 'cliphist watcher missing'
"
check_fail "no struts block (waybar reserves its own space)" grep -q 'struts' "$repo_path/config/niri/config.kdl"
check_fail "kitty config is self-contained (no external includes)" grep -q '^include' "$repo_path/config/kitty/kitty.conf"
check "clipboard picker parses" bash -n "$repo_path/bin/clipboard-history"
check "libnotify in packages (notification senders)" grep -qx 'libnotify' "$repo_path/install/packages"
check "papers (not evince) in packages" grep -qx 'papers' "$repo_path/install/packages"
check_fail "no evince in packages" grep -qx 'evince' "$repo_path/install/packages"
check_fail "no avahi without nsswitch integration" grep -qx 'avahi' "$repo_path/install/packages"
check_fail "no tensaku references" grep -rqi 'tensaku' "$repo_path/config" "$repo_path/install" "$repo_path/bin"
check "waybar ai-usage uses absolute path" grep -q '~/.local/bin/ai-usage' "$repo_path/config/waybar/config.jsonc"
check "user setup copies (not symlinks) ai-usage" grep -q 'cp -a "\$repo/bin/ai-usage"' "$repo_path/install/user.sh"
check "waybar config is JSON" python3 -c "
import json
json.load(open('$repo_path/config/waybar/config.jsonc'))
"
check "greetd config exists" test -f "$repo_path/etc/greetd/config.toml"

# Compile in memory, without leaving __pycache__ in managed helper directories.
check "AI helpers compile" python3 -c '
import pathlib, sys
root = pathlib.Path(sys.argv[1])
for path in [root / "bin/ai-usage", *root.glob("bin/ai-usage-scanners/*.py")]:
  compile(path.read_text(), str(path), "exec")
' "$repo_path"
if ! python3 "$repo_path/test/regressions.py"; then
  failures=$((failures + 1))
fi
if command -v niri >/dev/null 2>&1; then
  check "Niri validates its config" niri validate --config "$repo_path/config/niri/config.kdl"
else
  printf 'skip: Niri validation (available in Arch CI)\n'
fi
if command -v systemd-analyze >/dev/null 2>&1; then
  check "systemd validates battery unit" systemd-analyze verify "$repo_path/etc/systemd/system/blarchy-battery-limit.service"
else
  printf 'skip: systemd validation (available in Arch CI)\n'
fi

# Night-mode toggle and caffeinate widget.
check "night-mode parses" bash -n "$repo_path/bin/night-mode"
check "night-mode status emits JSON" bash -c \
  "'$repo_path/bin/night-mode' status | python3 -c 'import json,sys; json.load(sys.stdin)'"
check "gammastep in packages" grep -qx 'gammastep' "$repo_path/install/packages"
check "procps-ng in packages" grep -qx 'procps-ng' "$repo_path/install/packages"
check "uBlock Origin for Firefox in packages" grep -qx 'firefox-ublock-origin' "$repo_path/install/packages"
check "Dark Reader for Firefox in packages" grep -qx 'firefox-dark-reader' "$repo_path/install/packages"
check "Firefox policies are valid JSON" python3 -m json.tool "$repo_path/etc/firefox/policies/policies.json"
check "waybar has night-mode module" grep -q 'custom/night-mode' "$repo_path/config/waybar/config.jsonc"
check "waybar has caffeinate module" grep -q 'idle_inhibitor' "$repo_path/config/waybar/config.jsonc"
check "niri restores night-mode at login" grep -q 'night-mode.*run' "$repo_path/config/niri/config.kdl"
check "helpers referenced by login-proof path" bash -c \
  "grep -q '~/.local/bin/night-mode' '$repo_path/config/waybar/config.jsonc' '$repo_path/config/niri/config.kdl'"
check "user setup installs night-mode" grep -q 'bin/night-mode' "$repo_path/install/user.sh"

# Wallpaper and terminal theme.
check "wallpaper bundled" test -f "$repo_path/config/swaybg/wallpaper.jpg"
check "niri shows the wallpaper" grep -q 'swaybg -i ~/.config/swaybg/wallpaper.jpg' "$repo_path/config/niri/config.kdl"
check "kitty uses the Ubuntu theme" grep -q 'background #300a24' "$repo_path/config/kitty/kitty.conf"
check_fail "no Tokyo Night leftovers anywhere" grep -rqi -E \
  '1a1b26|c0caf5|7dcfff|7aa2f7|bb9af7|f7768e|9ece6a|e0af68|a9b1d6|414868|24283b|565f89|33467c' \
  "$repo_path/config" "$repo_path/bin" "$repo_path/etc" "$repo_path/logo.svg"

# External display discovery.
check "displays parses" bash -n "$repo_path/bin/displays"
check "displays prints usage" bash "$repo_path/bin/displays" --help
check "hardware check covers displays" grep -q 'blarchy_detect_displays' "$repo_path/install/hardware.sh"
check "niri output examples stay inert until enabled" grep -q '/-output' "$repo_path/config/niri/config.kdl"
check_fail "no bare output block (Niri requires a name)" grep -q '^output {' "$repo_path/config/niri/config.kdl"
check_fail "mouse-follow is omitted, never set off" grep -q 'focus-follows-mouse' "$repo_path/config/niri/config.kdl"

# Battery charge clamp.
check "battery-limit unit exists" test -f "$repo_path/etc/systemd/system/blarchy-battery-limit.service"
check "battery-limit script parses" bash -n "$repo_path/etc/lib/blarchy/battery-limit"
check "system setup installs the battery unit" grep -q 'blarchy-battery-limit' "$repo_path/install/system.sh"

# Removed desktops stay removed.
check_fail "unused text logo is removed" test -e "$repo_path/logo.txt"
check_fail "no obsolete branding in shipped files or docs" grep -rqiE \
  'omarchy|omakub|hyprland|xfce' \
  "$repo_path/logo.svg" "$repo_path/README.md" \
  "$repo_path/docs" "$repo_path/config" "$repo_path/bin" "$repo_path/etc" "$repo_path/install"
check "OpenCode separates runtime and TUI settings" python3 -c "
import json
from pathlib import Path
config = Path('$repo_path/config/opencode')
runtime = json.loads((config / 'opencode.json').read_text())
tui = json.loads((config / 'tui.json').read_text())
assert not {'theme', 'keybinds', 'tui'} & runtime.keys()
assert runtime['autoupdate'] is False
assert tui['theme'] == 'system'
"
check_fail "no hypr config" test -e "$repo_path/config/hypr"
check_fail "no xfce config" test -e "$repo_path/config/xfce4"
check_fail "no quickshell dir" test -e "$repo_path/shell"
check "bin/ holds only managed helpers" python3 -c "
from pathlib import Path
names = sorted(p.name for p in Path('$repo_path/bin').iterdir() if p.name != '__pycache__')
assert names == ['ai-usage', 'ai-usage-scanners', 'clipboard-history', 'displays', 'network-settings', 'night-mode'], names
"
check "network settings helper parses" bash -n "$repo_path/bin/network-settings"
if command -v dconf >/dev/null 2>&1; then
  check "dark-mode defaults compile" bash -c '
    temporary=$(mktemp -d)
    trap '\''rm -rf -- "$temporary"'\'' EXIT
    dconf compile "$temporary/database" "$1/etc/dconf/db/blarchy.d"
  ' test "$repo_path"
else
  printf 'skip: dconf validation (available in Arch CI)\n'
fi
check_fail "removed and hardware-only utilities absent from base packages" grep -xE \
  'zoxide|fzf|bluez|bluez-utils|blueman|power-profiles-daemon|brightnessctl' "$repo_path/install/packages"
check "Git defaults to main" git config --file "$repo_path/config/git/config" --get --fixed-value init.defaultBranch main

if (( failures > 0 )); then
  printf '%d check(s) failed\n' "$failures" >&2
  exit 1
fi
printf 'All smoke checks passed\n'
