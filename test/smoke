#!/bin/bash

# Offline smoke checks for the Arch desktop installer.
#
# Usage: ./test/smoke

set -euo pipefail

repo_path=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
cd "$repo_path"
failures=0

check() {
  local description="$1"
  shift
  if "$@" >/dev/null 2>&1; then
    printf 'ok: %s\n' "$description"
  else
    printf 'FAIL: %s\n' "$description"
    failures=$((failures + 1))
  fi
}

check_fail() {
  local description="$1"
  shift
  if "$@" >/dev/null 2>&1; then
    printf 'FAIL: %s\n' "$description"
    failures=$((failures + 1))
  else
    printf 'ok: %s\n' "$description"
  fi
}

shell_files=(
  "$repo_path/install.sh"
  "$repo_path/install/hardware.sh"
  "$repo_path/install/system.sh"
  "$repo_path/install/user.sh"
  "$repo_path/install/pam.sh"
  "$repo_path/test/smoke"
  "$repo_path/bin/clipboard-history"
  "$repo_path/bin/control-menu"
  "$repo_path/bin/desktop-session"
  "$repo_path/bin/desktop-settings"
  "$repo_path/bin/desktop-settings-apply"
  "$repo_path/bin/dev"
  "$repo_path/bin/displays"
  "$repo_path/bin/keep-awake"
  "$repo_path/bin/screenshot"
  "$repo_path/bin/session-controls"
  "$repo_path/bin/settings-menu"
  "$repo_path/etc/lib/battery-charge-limit"
)
for path in "${shell_files[@]}"; do
  check "${path#"$repo_path"/} parses" bash -n "$path"
done
if command -v shellcheck >/dev/null 2>&1; then
  check "shellcheck installer and desktop scripts" shellcheck -S warning "${shell_files[@]}"
else
  printf 'skip: shellcheck not installed\n'
fi

for manifest in packages packages-aur; do
  check "install/$manifest is non-empty" test -s "$repo_path/install/$manifest"
done
check "Hyprland in official package list" grep -qx 'hyprland' "$repo_path/install/packages"
check "Quickshell in official package list" grep -qx 'quickshell' "$repo_path/install/packages"
check "Wofi in official package list" grep -qx 'wofi' "$repo_path/install/packages"
check "Ghostty in official package list" grep -qx 'ghostty' "$repo_path/install/packages"
check "Neovim in official package list" grep -qx 'neovim' "$repo_path/install/packages"
check "Codex uses the official package" grep -qx 'openai-codex' "$repo_path/install/packages"
check "Fastfetch replaces Neofetch" grep -qx 'fastfetch' "$repo_path/install/packages"
check "Nerd Font symbols remain available without a Nerd text face" grep -qx 'ttf-nerd-fonts-symbols-mono' "$repo_path/install/packages"
check "Firefox is installed from pacman without duplicate extension packages" python3 -c '
from pathlib import Path
packages = [line.split("#", 1)[0].strip() for line in Path("install/packages").read_text().splitlines()]
packages = [line for line in packages if line]
assert "firefox" in packages
assert not {"firefox-ublock-origin", "firefox-dark-reader"} & set(packages)
'
check_fail "Neofetch absent from packages" grep -qi 'neofetch' "$repo_path/install/packages" "$repo_path/install/packages-aur"
check "only approved AUR exceptions are listed" python3 -c '
from pathlib import Path
packages = [line.split("#", 1)[0].strip() for line in Path("install/packages-aur").read_text().splitlines()]
packages = [line for line in packages if line]
assert packages == ["blesh-git", "tamsyn-font", "terminus-font-ttf"], packages
'
check "yay checks development updates by default" grep -qx 'yay -Y --devel --save' "$repo_path/install.sh"

check "Neovim config is empty" test ! -s "$repo_path/config/nvim/init.lua"
check "Hyprland Lua config exists" test -s "$repo_path/config/hypr/hyprland.lua"
check "Quickshell shows the Arch logo" grep -Fq '\uf303' "$repo_path/config/quickshell/shell.qml"
check "Hyprland starts directly from the TTY" grep -q '^start-hyprland$' "$repo_path/README.md"
check_fail "system integration does not enable a display manager" \
  grep -qE 'sddm\.service|display-manager\.service' "$repo_path/install/system.sh"
check_fail "no SDDM config" test -e "$repo_path/etc/sddm.conf.d"
check_fail "no Niri config" test -e "$repo_path/config/niri"
check_fail "no Kitty config" test -e "$repo_path/config/kitty"
check_fail "no Waybar config" test -e "$repo_path/config/waybar"
check_fail "no Fuzzel config" test -e "$repo_path/config/fuzzel"
check_fail "no OpenCode config" test -e "$repo_path/config/opencode"
check_fail "no display-manager package" grep -qxE 'sddm|greetd|greetd-tuigreet' "$repo_path/install/packages"
check_fail "no removed desktop packages" grep -qxE 'niri|kitty|waybar|fuzzel|prettymux|neofetch|opencode-bin|claude-code|oh-my-pi-bin' \
  "$repo_path/install/packages" "$repo_path/install/packages-aur"
check_fail "Codex is not installed from the AUR binary package" grep -qx 'openai-codex-bin' \
  "$repo_path/install/packages" "$repo_path/install/packages-aur"

check "Ghostty config uses the Terminus TTF font" grep -q '^font-family = "Terminus (TTF)"$' "$repo_path/config/ghostty/config"
check_fail "JetBrains Mono Nerd Font is no longer a default" rg -n 'JetBrainsMono Nerd Font|ttf-jetbrains-mono-nerd' \
  "$repo_path/config" "$repo_path/install/packages" "$repo_path/install/packages-aur"
check "Ghostty uses its configured background" grep -qx 'background = #1a1b26' "$repo_path/config/ghostty/config"
check_fail "Quickshell omits the AI usage indicator" grep -q 'ai-usage.*--json' "$repo_path/config/quickshell/shell.qml"
check "Quickshell status helpers use absolute paths" grep -q 'HOME.*desktop-status' "$repo_path/config/quickshell/shell.qml"
check "Super+Space uses the application launcher" grep -q 'SUPER + Space.*exec(launcher)' "$repo_path/config/hypr/hyprland.lua"
check "application launcher uses Wofi" grep -q 'local launcher = "wofi ' "$repo_path/config/hypr/hyprland.lua"
check "Super+Shift+Space opens the control menu" grep -q 'SUPER + SHIFT + Space.*control-menu' "$repo_path/config/hypr/hyprland.lua"
check "Super+S opens the settings menu" grep -q 'SUPER + S.*desktop-settings' "$repo_path/config/hypr/hyprland.lua"
check "Hyprland loads session services on start" grep -q 'hypridle.service hyprsunset.service' "$repo_path/config/hypr/hyprland.lua"
check "desktop processes stop with the graphical session" grep -q '^PartOf=graphical-session.target$' \
  "$repo_path/config/systemd/user/desktop-session.service"
check "desktop session launcher is installed" grep -q 'desktop-session' "$repo_path/install/user.sh"
check "monitor rules handle dock events" grep -q 'monitor.added' "$repo_path/config/hypr/monitors.lua"
check "dock mirror rules use 8-bit output" grep -q 'bitdepth = 8' "$repo_path/config/hypr/monitors.lua"
check "external keyboard rule maps Cmd and Windows modifiers" python3 -c '
from pathlib import Path
text = Path("etc/udev/hwdb.d/90-external-keyboard.hwdb").read_text()
assert "evdev:input:b0003v1FC9pE8C7*" in text
for mapping in (
  "KEYBOARD_KEY_700e2=leftmeta", "KEYBOARD_KEY_700e3=leftalt",
  "KEYBOARD_KEY_700e6=rightmeta", "KEYBOARD_KEY_700e7=rightalt",
):
  assert mapping in text, mapping
'
check_fail "no keyd configuration" test -e "$repo_path/etc/keyd"
check "battery service has a generic name" test -f "$repo_path/etc/systemd/system/battery-charge-limit.service"
check_fail "no branded runtime names" rg -qi 'blarchy|blix' "$repo_path/bin" "$repo_path/config" "$repo_path/etc" \
  "$repo_path/install/hardware.sh" "$repo_path/install/system.sh" "$repo_path/install/user.sh" "$repo_path/install/pam.sh"

check "firefox policies are valid JSON" python3 -m json.tool "$repo_path/etc/firefox/policies/policies.json"
check "AI helper and Python scanner compile" python3 -c '
from pathlib import Path
root = Path(".")
for path in [root / "bin/ai-usage", *root.glob("bin/ai-usage-scanners/*.py"), root / "bin/system-info"]:
  compile(path.read_text(), str(path), "exec")
'
if command -v systemd-analyze >/dev/null 2>&1 && [[ -x /bin/bash && -x /usr/bin/systemd-inhibit ]]; then
  check "battery-limit unit verifies" systemd-analyze verify "$repo_path/etc/systemd/system/battery-charge-limit.service"
  check "keep-awake unit syntax verifies" systemd-analyze verify "$repo_path/config/systemd/user/keep-awake.service"
else
  printf 'skip: systemd unit validation needs standard Arch paths\n'
fi
if command -v dconf >/dev/null 2>&1; then
  check "dconf defaults compile" bash -c '
    temporary=$(mktemp -d)
    trap '\''rm -rf -- "$temporary"'\'' EXIT
    dconf compile "$temporary/database" "$1/etc/dconf/db/desktop.d"
  ' test "$repo_path"
else
  printf 'skip: dconf validation not installed\n'
fi
if command -v lua >/dev/null 2>&1; then
  check "Hyprland Lua configs parse" lua -e 'assert(loadfile("config/hypr/hyprland.lua")); assert(loadfile("config/hypr/monitors.lua")); os.exit(0)'
else
  printf 'skip: Lua parser not installed\n'
fi

if ! python3 "$repo_path/test/regressions.py"; then
  failures=$((failures + 1))
fi

if (( failures > 0 )); then
  printf '%d check(s) failed\n' "$failures" >&2
  exit 1
fi
printf 'All smoke checks passed\n'
